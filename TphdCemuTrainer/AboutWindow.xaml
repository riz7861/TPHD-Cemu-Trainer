<Window x:Class="TphdCemuTrainer.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About / Credits"
        Width="590"
        Height="460"
        MinWidth="520"
        MinHeight="380"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F0F0F0" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FAFAFA" />
        <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextBrush" Color="#111111" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#555555" />
        <SolidColorBrush x:Key="BorderBrush" Color="#B8B8B8" />
        <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#FFF8E6" />
        <SolidColorBrush x:Key="WarningBorderBrush" Color="#D9A23A" />
        <SolidColorBrush x:Key="WarningTextBrush" Color="#6F4700" />
        <SolidColorBrush x:Key="ControlHoverBackgroundBrush" Color="#F2F7FC" />
        <SolidColorBrush x:Key="ControlFocusedBorderBrush" Color="#1F6FB2" />
        <SolidColorBrush x:Key="DisabledTextBrush" Color="#777777" />
        <SolidColorBrush x:Key="DisabledControlBackgroundBrush" Color="#E8E8E8" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>

        <DataTemplate x:Key="CreditEntryTemplate">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           VerticalAlignment="Top" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Contribution}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ApplicationTitle}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="For The Legend of Zelda: Twilight Princess HD on Cemu."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,10" />

                    <Border BorderBrush="{DynamicResource WarningBorderBrush}"
                            BorderThickness="1"
                            Background="{DynamicResource WarningBackgroundBrush}"
                            Padding="8"
                            Margin="0,0,0,12">
                        <TextBlock Text="Back up your save before using this trainer."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource WarningTextBrush}"
                                   FontWeight="SemiBold" />
                    </Border>

                    <TextBlock Text="Credits"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding CreditEntries}"
                                  ItemTemplate="{StaticResource CreditEntryTemplate}"
                                  Margin="0,0,0,12" />

                    <TextBlock Text="{Binding CreditsAcknowledgement}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{Binding CreditsMissingContributorNotice}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Close"
                    IsCancel="True"
                    IsDefault="True"
                    Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
