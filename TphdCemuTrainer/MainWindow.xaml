<Window x:Class="TphdCemuTrainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TPHD Cemu Trainer"
        Height="760"
        MinHeight="680"
        Width="1120"
        MinWidth="980"
        Background="#F0F0F0"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="3,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="25" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="25" />
            <Setter Property="MinWidth" Value="98" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="7" />
            <Setter Property="Padding" Value="9" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="12,5" />
        </Style>

        <DataTemplate x:Key="EditableValueTemplate">
            <Grid Margin="0,4" ToolTip="{Binding Source}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="135" />
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="82" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding Name}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <TextBox Grid.Column="1"
                         Text="{Binding CurrentValue, Mode=OneWay}"
                         IsReadOnly="True"
                         Background="#F7F7F7" />
                <TextBox Grid.Column="2"
                         Text="{Binding TargetValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Margin="6,0,0,0" />
                <Button Grid.Column="3"
                        Content="Set"
                        Tag="{Binding}"
                        Click="SetValue_Click" />
                <Button Grid.Column="4"
                        Content="Max"
                        Tag="{Binding}"
                        Click="MaxValue_Click" />
                <CheckBox Grid.Column="5"
                          Content="{Binding LockText}"
                          IsChecked="{Binding IsLocked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          IsEnabled="{Binding CanLock}"
                          VerticalAlignment="Center"
                          Margin="6,0,0,0" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ReadOnlyRawValueTemplate">
            <Grid Margin="0,3" ToolTip="{Binding Source}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="135" />
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="112" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Offset}"
                           FontFamily="Consolas"
                           VerticalAlignment="Center" />
                <TextBox Grid.Column="2"
                         Text="{Binding CurrentValue, Mode=OneWay}"
                         IsReadOnly="True"
                         Background="#F7F7F7" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CapacityTemplate">
            <Grid Margin="0,4" ToolTip="{Binding Source}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="135" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="130" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Options}"
                          DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          SelectionChanged="CapacityCombo_SelectionChanged"
                          Tag="{Binding}" />
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           Foreground="#555">
                    <Run Text="Stored:" />
                    <Run Text="{Binding CurrentStoredValue, Mode=OneWay}" />
                </TextBlock>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FutureCheckTemplate">
            <CheckBox Content="{Binding Name}"
                      IsEnabled="False"
                      ToolTip="{Binding Notes}"
                      Margin="0,3" />
        </DataTemplate>

        <DataTemplate x:Key="FutureTextTemplate">
            <TextBlock Text="{Binding Name}"
                       ToolTip="{Binding Notes}"
                       Margin="0,3"
                       Foreground="#555" />
        </DataTemplate>

        <DataTemplate x:Key="InventoryOwnershipItemTemplate">
            <Border BorderBrush="#D8D8D8"
                    BorderThickness="0,0,0,1"
                    Padding="0,5"
                    ToolTip="{Binding Notes}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="82" />
                        <ColumnDefinition Width="105" />
                        <ColumnDefinition Width="*" MinWidth="220" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding Name}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding CurrentDetectedState, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="6,0" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding FlagLocation}"
                               Foreground="#7A4A00"
                               VerticalAlignment="Center"
                               Margin="6,0" />
                    <CheckBox Grid.Column="3"
                              IsChecked="{Binding TargetOwned, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding CanEdit}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4"
                               Text="{Binding EditStatus}"
                               Foreground="#555"
                               VerticalAlignment="Center"
                               Margin="6,0" />
                    <TextBlock Grid.Column="5"
                               Text="{Binding Notes}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="6,0" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="InventorySlotReadOnlyTemplate">
            <Border BorderBrush="#D8D8D8"
                    BorderThickness="0,0,0,1"
                    Padding="0,4"
                    ToolTip="{Binding Notes}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="*" MinWidth="150" />
                        <ColumnDefinition Width="166" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding SlotLabel}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Offset}"
                               FontFamily="Consolas"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding CurrentItemId, Mode=OneWay}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding CurrentItemName, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4"
                               Text="{Binding ManagementStatus}"
                               Foreground="#7A4A00"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="6,0" />
                    <TextBlock Grid.Column="5"
                               Text="{Binding Notes}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="6,0" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="InventorySlotTemplate">
            <Border BorderBrush="#D8D8D8"
                    BorderThickness="0,0,0,1"
                    Padding="0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="*" MinWidth="150" />
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="62" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding SlotNumber}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Offset}"
                               FontFamily="Consolas"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding CurrentItemId, Mode=OneWay}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding CurrentItemName, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4"
                               Text="{Binding ManagementStatus}"
                               Foreground="#7A4A00"
                               VerticalAlignment="Center"
                               Margin="6,0" />
                    <ComboBox Grid.Column="5"
                              ItemsSource="{Binding AvailableItems}"
                              DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Margin="6,0" />
                    <Button Grid.Column="6"
                            Content="Apply"
                            IsEnabled="{Binding CanEdit}"
                            Tag="{Binding}"
                            Click="ApplyInventorySlot_Click" />
                    <Button Grid.Column="7"
                            Content="Clear"
                            IsEnabled="{Binding CanEdit}"
                            Tag="{Binding}"
                            Click="ClearInventorySlot_Click" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="EquipmentSlotTemplate">
            <Border BorderBrush="#D8D8D8"
                    BorderThickness="0,0,0,1"
                    Padding="0,5"
                    ToolTip="{Binding Source}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="*" MinWidth="150" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding Name}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Offset}"
                               FontFamily="Consolas"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding CurrentValue, Mode=OneWay}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding CurrentName, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="EquipmentFlagTemplate">
            <Border BorderBrush="#D8D8D8"
                    BorderThickness="0,0,0,1"
                    Padding="0,5"
                    ToolTip="{Binding Source}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="180" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="52" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Content="{Binding Name}"
                              IsChecked="{Binding IsOwnedDesired, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding CanEdit}"
                              VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding IsOwnedDetected, Mode=OneWay}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding Offset}"
                               FontFamily="Consolas"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding Bit}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4"
                               Text="{Binding BackingValue, Mode=OneWay}"
                               FontFamily="Consolas"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="5"
                               Text="{Binding IsDirty, Mode=OneWay}"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ResearchRangeRowTemplate">
            <Border BorderBrush="#D8D8D8"
                    BorderThickness="0,0,0,1"
                    Padding="0,4">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                <Setter Property="Background" Value="#FFF3C4" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="*" MinWidth="120" />
                        <ColumnDefinition Width="*" MinWidth="120" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding Offset}"
                               FontFamily="Consolas"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding BeforeByte}"
                               FontFamily="Consolas"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding CurrentByte}"
                               FontFamily="Consolas"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding BeforeItemName}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4"
                               Text="{Binding CurrentItemName}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="5"
                               Text="{Binding IsChanged}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ResearchSnapshotTemplate">
            <Border BorderBrush="#D8D8D8"
                    BorderThickness="0,0,0,1"
                    Padding="0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="130" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" MinWidth="130" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding TimestampText}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding Notes}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding RangeCount}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ResearchSnapshotCompareRowTemplate">
            <Border BorderBrush="#D8D8D8"
                    BorderThickness="0,0,0,1"
                    Padding="0,4">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                <Setter Property="Background" Value="#FFF3C4" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" MinWidth="110" />
                        <ColumnDefinition Width="*" MinWidth="110" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Offset}" FontFamily="Consolas" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding SnapshotAByte}" FontFamily="Consolas" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding SnapshotBByte}" FontFamily="Consolas" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding Difference}" FontFamily="Consolas" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{Binding SnapshotADecode}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="5" Text="{Binding SnapshotBDecode}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="6" Text="{Binding IsChanged}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="#B8B8B8"
                BorderThickness="1"
                Background="#FAFAFA"
                Padding="9"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="AttachButton"
                            Content="Attach / Rescan"
                            Click="AttachButton_Click" />
                    <Button x:Name="DetachButton"
                            Content="Detach"
                            IsEnabled="False"
                            Click="DetachButton_Click" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="18,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot"
                                 Width="10"
                                 Height="10"
                                 Fill="#808080"
                                 Margin="0,0,8,0" />
                        <TextBlock x:Name="StatusText"
                                   Text="Not attached"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="18,4,0,0">
                        <TextBlock Text="Player Data:" Foreground="#555" Margin="0,0,4,0" />
                        <TextBlock x:Name="PlayerDataStateText"
                                   Text="Not Ready"
                                   FontWeight="SemiBold"
                                   Margin="0,0,14,0" />
                        <TextBlock Text="Inventory:" Foreground="#555" Margin="0,0,4,0" />
                        <TextBlock x:Name="InventoryStateText"
                                   Text="-"
                                   FontWeight="SemiBold"
                                   Margin="0,0,14,0" />
                        <TextBlock Text="Equipment:" Foreground="#555" Margin="0,0,4,0" />
                        <TextBlock x:Name="EquipmentStateText"
                                   Text="-"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="PID:" Margin="0,0,4,0" />
                    <TextBlock x:Name="PidText"
                               Text="-"
                               FontWeight="SemiBold"
                               Margin="0,0,16,0" />
                    <TextBlock Text="Player base:" Margin="0,0,4,0" />
                    <TextBlock x:Name="PlayerBaseText"
                               Text="-"
                               FontFamily="Consolas"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1"
                    x:Name="TrainerTabs"
                    Background="#F0F0F0">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <UniformGrid Columns="2" Margin="6">
                        <GroupBox Header="Player">
                            <StackPanel>
                                <ContentControl Content="{Binding CurrentHealth}"
                                                ContentTemplate="{StaticResource EditableValueTemplate}" />
                                <ContentControl Content="{Binding MaximumHealth}"
                                                ContentTemplate="{StaticResource EditableValueTemplate}" />
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Heart containers" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             x:Name="HeartContainersText"
                                             Text="Not read"
                                             IsReadOnly="True"
                                             Background="#F7F7F7" />
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Heart pieces" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             x:Name="TotalHeartPiecesText"
                                             Text="Not mapped in CT"
                                             IsReadOnly="True"
                                             Background="#F7F7F7" />
                                </Grid>
                                <ContentControl Content="{Binding LanternOil}"
                                                ContentTemplate="{StaticResource EditableValueTemplate}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Wallet">
                            <StackPanel>
                                <ContentControl Content="{Binding WalletCapacity}"
                                                ContentTemplate="{StaticResource CapacityTemplate}" />
                                <ContentControl Content="{Binding Rupees}"
                                                ContentTemplate="{StaticResource EditableValueTemplate}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Collectibles Summary">
                            <StackPanel>
                                <ContentControl Content="{Binding PoeSouls}"
                                                ContentTemplate="{StaticResource EditableValueTemplate}" />
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Golden Bugs count" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             x:Name="GoldenBugsCountText"
                                             Text="Not read"
                                             IsReadOnly="True"
                                             Background="#F7F7F7" />
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Total Heart Pieces" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding ElementName=TotalHeartPiecesText, Path=Text, Mode=OneWay}"
                                             IsReadOnly="True"
                                             Background="#F7F7F7" />
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Notes">
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="#555"
                                       Text="Capacity-limited edits are clamped to the selected capacity before writing. If player data is not found, load into gameplay and rescan." />
                        </GroupBox>
                    </UniformGrid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Inventory">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6">
                        <GroupBox Header="Owned / Unlocked Inventory Items">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="#7A4A00"
                                           Margin="0,0,0,8"
                                           Text="Inventory ownership/progression flags have not been mapped yet. Visible inventory slots appear to be rebuilt from authoritative flags, so these items are detection-only for now." />

                                <Border BorderBrush="#D9A23A"
                                        BorderThickness="1"
                                        Background="#FFF8E6"
                                        Padding="8"
                                        Margin="0,0,0,8">
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="#6F4700"
                                               FontWeight="SemiBold"
                                               Text="Ownership flag unknown. Raw inventory slots are game-managed and may revert. The trainer will not fake ownership by writing raw inventory slots." />
                                </Border>

                                <Border BorderBrush="#D9A23A"
                                        BorderThickness="1"
                                        Background="#FFF8E6"
                                        Padding="8"
                                        Margin="0,0,0,8">
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="#6F4700"
                                               FontWeight="SemiBold"
                                               Text="If the in-game inventory menu is already open, close and reopen it after applying future ownership changes to refresh displayed items." />
                                </Border>

                                <Border x:Name="InventoryInitializationWarningText"
                                        Visibility="Collapsed"
                                        BorderBrush="#D9A23A"
                                        BorderThickness="1"
                                        Background="#FFF8E6"
                                        Padding="8"
                                        Margin="0,0,0,8">
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="#6F4700"
                                               FontWeight="SemiBold"
                                               Text="Inventory has not been initialized by the game yet.&#x0a;&#x0a;You appear to be at a very early point in the story.&#x0a;&#x0a;Progress until Link obtains a real inventory item (Fishing Rod, Slingshot, Lantern, etc.) then click Attach / Rescan." />
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="Refresh Inventory"
                                            Click="RefreshInventoryButton_Click" />
                                    <TextBlock Text="Current detected state is read from CT-derived visible slots and is not proof of an authoritative ownership flag."
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0"
                                               Foreground="#555" />
                                </StackPanel>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="105" />
                                        <ColumnDefinition Width="*" MinWidth="220" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Item" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Current detected state" FontWeight="SemiBold" Margin="6,0" />
                                    <TextBlock Grid.Column="2" Text="Ownership flag" FontWeight="SemiBold" Margin="6,0" />
                                    <TextBlock Grid.Column="3" Text="Owned" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="Edit status" FontWeight="SemiBold" Margin="6,0" />
                                    <TextBlock Grid.Column="5" Text="Notes" FontWeight="SemiBold" Margin="6,0" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding InventoryOwnershipItems}"
                                              ItemTemplate="{StaticResource InventoryOwnershipItemTemplate}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Current Inventory Slots (Read Only)">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="#555"
                                           Margin="0,0,0,8"
                                           Text="These 24 bytes are CT-derived visible inventory fields from _playerbase+0x258 through _playerbase+0x26F. They are shown for detection and research; normal inventory editing does not write them." />

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="74" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="*" MinWidth="150" />
                                        <ColumnDefinition Width="166" />
                                        <ColumnDefinition Width="300" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Slot" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Offset" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="Raw item ID" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Decoded item name" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="4" Text="Managed field" FontWeight="SemiBold" Margin="6,0" />
                                    <TextBlock Grid.Column="5" Text="Notes" FontWeight="SemiBold" Margin="6,0" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding InventorySlots}"
                                              ItemTemplate="{StaticResource InventorySlotReadOnlyTemplate}" />
                            </StackPanel>
                        </GroupBox>

                        <Expander Header="Advanced / Raw Inventory Writes (Unsafe)" IsExpanded="False">
                            <GroupBox Header="Unsafe Raw Inventory Writes">
                                <StackPanel>
                                    <Border BorderBrush="#D9A23A"
                                            BorderThickness="1"
                                            Background="#FFF8E6"
                                            Padding="8"
                                            Margin="0,0,0,8">
                                        <TextBlock TextWrapping="Wrap"
                                                   Foreground="#6F4700"
                                                   FontWeight="SemiBold"
                                                   Text="Raw inventory writes are experimental. TPHD may immediately revert invalid writes. Use only for research on copied saves." />
                                    </Border>

                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="#7A4A00"
                                               Margin="0,0,0,8"
                                               Text="This section exposes all CT item IDs for diagnostics. Raw inventory slots are game-managed and may revert; the game likely rebuilds them from ownership/progression flags elsewhere." />

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <CheckBox Content="Enable unsafe raw inventory writes"
                                                  IsChecked="{Binding AllowUnsafeRawInventoryWrites, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
