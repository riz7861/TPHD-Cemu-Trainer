                                    Margin="0,0,0,8">
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{DynamicResource WarningTextBrush}"
                                           FontWeight="SemiBold"
                                           Text="Golden Bugs editing is experimental. Only confirmed bits are labeled. Setting unknown bits may mark an unknown bug or affect unused/reserved data. Use copied saves." />
