<Window x:Class="TphdCemuTrainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TPHD Cemu Trainer"
        Height="760"
        MinHeight="680"
        Width="1120"
        MinWidth="980"
        Background="#F0F0F0"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="3,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="25" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="25" />
            <Setter Property="MinWidth" Value="98" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="7" />
            <Setter Property="Padding" Value="9" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="12,5" />
        </Style>

        <DataTemplate x:Key="EditableValueTemplate">
            <Grid Margin="0,4" ToolTip="{Binding Source}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="135" />
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="82" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding Name}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <TextBox Grid.Column="1"
                         Text="{Binding CurrentValue, Mode=OneWay}"
                         IsReadOnly="True"
                         Background="#F7F7F7" />
                <TextBox Grid.Column="2"
                         Text="{Binding TargetValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Margin="6,0,0,0" />
                <Button Grid.Column="3"
                        Content="Set"
                        Tag="{Binding}"
                        Click="SetValue_Click" />
                <Button Grid.Column="4"
                        Content="Max"
                        Tag="{Binding}"
                        Click="MaxValue_Click" />
                <CheckBox Grid.Column="5"
                          Content="{Binding LockText}"
                          IsChecked="{Binding IsLocked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          IsEnabled="{Binding CanLock}"
                          VerticalAlignment="Center"
                          Margin="6,0,0,0" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ReadOnlyRawValueTemplate">
            <Grid Margin="0,3" ToolTip="{Binding Source}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="135" />
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="112" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Offset}"
                           FontFamily="Consolas"
                           VerticalAlignment="Center" />
                <TextBox Grid.Column="2"
                         Text="{Binding CurrentValue, Mode=OneWay}"
                         IsReadOnly="True"
                         Background="#F7F7F7" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CapacityTemplate">
            <Grid Margin="0,4" ToolTip="{Binding Source}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="135" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="130" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Options}"
                          DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          SelectionChanged="CapacityCombo_SelectionChanged"
                          Tag="{Binding}" />
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           Foreground="#555">
                    <Run Text="Stored:" />
                    <Run Text="{Binding CurrentStoredValue, Mode=OneWay}" />
                </TextBlock>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FutureCheckTemplate">
            <CheckBox Content="{Binding Name}"
                      IsEnabled="False"
                      ToolTip="{Binding Notes}"
                      Margin="0,3" />
        </DataTemplate>

        <DataTemplate x:Key="FutureTextTemplate">
            <TextBlock Text="{Binding Name}"
                       ToolTip="{Binding Notes}"
                       Margin="0,3"
                       Foreground="#555" />
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="#B8B8B8"
                BorderThickness="1"
                Background="#FAFAFA"
                Padding="9"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="AttachButton"
                            Content="Attach / Rescan"
                            Click="AttachButton_Click" />
                    <Button x:Name="DetachButton"
                            Content="Detach"
                            IsEnabled="False"
                            Click="DetachButton_Click" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="18,0">
                    <Ellipse x:Name="StatusDot"
                             Width="10"
                             Height="10"
                             Fill="#808080"
                             Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusText"
                               Text="Not attached"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="PID:" Margin="0,0,4,0" />
                    <TextBlock x:Name="PidText"
                               Text="-"
                               FontWeight="SemiBold"
                               Margin="0,0,16,0" />
                    <TextBlock Text="Player base:" Margin="0,0,4,0" />
                    <TextBlock x:Name="PlayerBaseText"
                               Text="-"
                               FontFamily="Consolas"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1"
                    x:Name="TrainerTabs"
                    Background="#F0F0F0">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <UniformGrid Columns="2" Margin="6">
                        <GroupBox Header="Player">
                            <StackPanel>
                                <ContentControl Content="{Binding CurrentHealth}"
                                                ContentTemplate="{StaticResource EditableValueTemplate}" />
                                <ContentControl Content="{Binding MaximumHealth}"
                                                ContentTemplate="{StaticResource EditableValueTemplate}" />
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Heart containers" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             x:Name="HeartContainersText"
                                             Text="Not read"
                                             IsReadOnly="True"
                                             Background="#F7F7F7" />
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Heart pieces" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             x:Name="TotalHeartPiecesText"
                                             Text="Not mapped in CT"
                                             IsReadOnly="True"
                                             Background="#F7F7F7" />
                                </Grid>
                                <ContentControl Content="{Binding LanternOil}"
                                                ContentTemplate="{StaticResource EditableValueTemplate}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Wallet">
                            <StackPanel>
                                <ContentControl Content="{Binding WalletCapacity}"
                                                ContentTemplate="{StaticResource CapacityTemplate}" />
                                <ContentControl Content="{Binding Rupees}"
                                                ContentTemplate="{StaticResource EditableValueTemplate}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Collectibles Summary">
                            <StackPanel>
                                <ContentControl Content="{Binding PoeSouls}"
                                                ContentTemplate="{StaticResource EditableValueTemplate}" />
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Golden Bugs count" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             x:Name="GoldenBugsCountText"
                                             Text="Not read"
                                             IsReadOnly="True"
                                             Background="#F7F7F7" />
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Total Heart Pieces" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding ElementName=TotalHeartPiecesText, Path=Text, Mode=OneWay}"
                                             IsReadOnly="True"
                                             Background="#F7F7F7" />
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Notes">
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="#555"
                                       Text="Capacity-limited edits are clamped to the selected capacity before writing. If player data is not found, load into gameplay and rescan." />
                        </GroupBox>
                    </UniformGrid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Inventory">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <UniformGrid Columns="2" Margin="6">
                        <GroupBox Header="Inventory-screen Items">
                            <ItemsControl ItemsSource="{Binding InventoryItems}"
                                          ItemTemplate="{StaticResource FutureCheckTemplate}" />
                        </GroupBox>
                        <GroupBox Header="Implementation Notes">
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="#555"
                                       Text="The CT exposes inventory slots as item IDs. Dedicated item ownership toggles are reserved until each item slot behavior can be mapped safely." />
                        </GroupBox>
                    </UniformGrid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Equipment">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <UniformGrid Columns="2" Margin="6">
                        <GroupBox Header="Weapons">
                            <ItemsControl ItemsSource="{Binding Weapons}"
                                          ItemTemplate="{StaticResource FutureCheckTemplate}" />
                        </GroupBox>
                        <GroupBox Header="Shields">
                            <ItemsControl ItemsSource="{Binding Shields}"
                                          ItemTemplate="{StaticResource FutureCheckTemplate}" />
                        </GroupBox>
                        <GroupBox Header="Armor">
                            <ItemsControl ItemsSource="{Binding Armor}"
                                          ItemTemplate="{StaticResource FutureCheckTemplate}" />
                        </GroupBox>
                        <GroupBox Header="Equipment">
                            <ItemsControl ItemsSource="{Binding Equipment}"
                                          ItemTemplate="{StaticResource FutureCheckTemplate}" />
                        </GroupBox>
                    </UniformGrid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Ammo &amp; Upgrades">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <UniformGrid Columns="2" Margin="6">
                        <GroupBox Header="Wallet">
                            <StackPanel>
                                <ContentControl Content="{Binding WalletCapacity}"
                                                ContentTemplate="{StaticResource CapacityTemplate}" />
                                <ContentControl Content="{Binding Rupees}"
                                                ContentTemplate="{StaticResource EditableValueTemplate}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Quiver">
                            <StackPanel>
                                <ContentControl Content="{Binding QuiverCapacity}"
                                                ContentTemplate="{StaticResource CapacityTemplate}" />
                                <ContentControl Content="{Binding Arrows}"
                                                ContentTemplate="{StaticResource EditableValueTemplate}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Bomb Bag 1">
                            <StackPanel>
                                <ContentControl Content="{Binding BombBagCapacity}"
                                                ContentTemplate="{StaticResource CapacityTemplate}" />
                                <ContentControl Content="{Binding BombSlot1}"
                                                ContentTemplate="{StaticResource EditableValueTemplate}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Bomb Bag 2">
                            <StackPanel>
                                <ContentControl Content="{Binding BombBagCapacity}"
                                                ContentTemplate="{StaticResource CapacityTemplate}" />
                                <ContentControl Content="{Binding BombSlot2}"
                                                ContentTemplate="{StaticResource EditableValueTemplate}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Bomb Bag 3">
                            <StackPanel>
                                <ContentControl Content="{Binding BombBagCapacity}"
                                                ContentTemplate="{StaticResource CapacityTemplate}" />
                                <ContentControl Content="{Binding BombSlot3}"
                                                ContentTemplate="{StaticResource EditableValueTemplate}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Seed Bag">
                            <StackPanel>
                                <ContentControl Content="{Binding SeedBagCapacity}"
                                                ContentTemplate="{StaticResource CapacityTemplate}" />
                                <ContentControl Content="{Binding Seeds}"
                                                ContentTemplate="{StaticResource EditableValueTemplate}" />
                            </StackPanel>
                        </GroupBox>
                    </UniformGrid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Collectibles">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <UniformGrid Columns="2" Margin="6">
                        <GroupBox Header="Poe Souls">
                            <ContentControl Content="{Binding PoeSouls}"
                                            ContentTemplate="{StaticResource EditableValueTemplate}" />
                        </GroupBox>
                        <GroupBox Header="Golden Bugs">
                            <StackPanel>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Collected" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding ElementName=GoldenBugsCountText, Path=Text, Mode=OneWay}"
                                             IsReadOnly="True"
                                             Background="#F7F7F7" />
                                </Grid>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="#555"
                                           Text="Individual bug tracking is reserved for a future save-editor pass." />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Heart Pieces">
                            <TextBox Text="{Binding ElementName=TotalHeartPiecesText, Path=Text, Mode=OneWay}"
                                     IsReadOnly="True"
                                     Background="#F7F7F7" />
                        </GroupBox>
                        <GroupBox Header="Heart Containers">
                            <TextBox x:Name="CollectiblesHeartContainersText"
                                     Text="Not read"
                                     IsReadOnly="True"
                                     Background="#F7F7F7" />
                        </GroupBox>
                    </UniformGrid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Story Flags">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <UniformGrid Columns="2" Margin="6">
                        <GroupBox Header="Story Progression">
                            <ItemsControl ItemsSource="{Binding StoryFlags}"
                                          ItemTemplate="{StaticResource FutureCheckTemplate}" />
                        </GroupBox>
                        <GroupBox Header="Warning">
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="#555"
                                       Text="Story flags can affect progression and event state. This area is intentionally reserved until flag behavior is verified." />
                        </GroupBox>
                    </UniformGrid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Hidden Skills">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <GroupBox Header="Skills" Margin="13">
                        <ItemsControl ItemsSource="{Binding HiddenSkills}"
                                      ItemTemplate="{StaticResource FutureCheckTemplate}" />
                    </GroupBox>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Quest Items">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <UniformGrid Columns="2" Margin="6">
                        <GroupBox Header="Quest Items">
                            <ItemsControl ItemsSource="{Binding QuestItems}"
                                          ItemTemplate="{StaticResource FutureCheckTemplate}" />
                        </GroupBox>
                        <GroupBox Header="Progression Notes">
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="#555"
                                       Text="Quest item editing will be added after item state, event flags, and save compatibility are mapped." />
                        </GroupBox>
                    </UniformGrid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Debug">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <UniformGrid Columns="2" Margin="6">
                        <GroupBox Header="Current Player Base">
                            <StackPanel>
                                <TextBox x:Name="DebugPlayerBaseText"
                                         Text="-"
                                         IsReadOnly="True"
                                         FontFamily="Consolas"
                                         Background="#F7F7F7" />
                                <TextBlock Text="AOB pattern"
                                           Margin="0,10,0,2" />
                                <TextBox x:Name="AobPatternText"
                                         IsReadOnly="True"
                                         FontFamily="Consolas"
                                         TextWrapping="Wrap"
                                         Background="#F7F7F7" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Raw Memory Values">
                            <ItemsControl ItemsSource="{Binding RawMemoryValues}"
                                          ItemTemplate="{StaticResource ReadOnlyRawValueTemplate}" />
                        </GroupBox>

                        <GroupBox Header="Advanced Tools">
                            <ItemsControl ItemsSource="{Binding DebugTools}"
                                          ItemTemplate="{StaticResource FutureTextTemplate}" />
                        </GroupBox>

                        <GroupBox Header="Coordinate Display">
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="#555"
                                       Text="Coordinate display and teleport tools are reserved for a future coordinate-base scan implementation." />
                        </GroupBox>
                    </UniformGrid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
