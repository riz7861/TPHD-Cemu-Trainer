                                             x:Name="HeartContainersText"
                                             Text="Not read"
                                             IsReadOnly="True"
                                             Background="{DynamicResource ReadOnlyBackgroundBrush}" />
                                </Grid>
                                <GroupBox Header="Heart Piece Progress" Margin="0,6,0,4">
                                    <StackPanel>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="140" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Heart Pieces Toward Next Heart"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center" />
