    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="Attach / Rescan"
                          Click="AttachButton_Click" />
                <MenuItem Header="Detach"
                          IsEnabled="{Binding ElementName=DetachButton, Path=IsEnabled}"
                          Click="DetachButton_Click" />
                <MenuItem Header="Exit"
                          Click="ExitMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="_Options">
                <MenuItem Header="Dark Mode"
                          IsCheckable="True"
                          IsChecked="{Binding IsDarkMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <MenuItem Header="Developer Mode"
                          IsCheckable="True"
                          IsChecked="{Binding IsDeveloperMode, Mode=OneWay}"
                          Click="DeveloperModeToggle_Click" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="Open Logs Folder"
                          Click="OpenLogsFolderMenuItem_Click" />
                <MenuItem Header="Open App Folder"
                          Click="OpenAppFolderMenuItem_Click" />
                <MenuItem Header="Research"
                          Tag="Research"
                          Visibility="{Binding DeveloperToolsVisibility}"
                          Click="OpenDeveloperToolMenuItem_Click" />
                <MenuItem Header="Debug"
                          Tag="Debug"
                          Visibility="{Binding DeveloperToolsVisibility}"
                          Click="OpenDeveloperToolMenuItem_Click" />
                <MenuItem Header="Live Capture"
                          Tag="Live Capture"
                          Visibility="{Binding DeveloperToolsVisibility}"
                          Click="OpenDeveloperToolMenuItem_Click" />
                <MenuItem Header="Snapshot Diff"
                          Tag="Snapshot Diff"
                          Visibility="{Binding DeveloperToolsVisibility}"
                          Click="OpenDeveloperToolMenuItem_Click" />
                <MenuItem Header="Candidate Tester"
                          Tag="Candidate Tester"
                          Visibility="{Binding DeveloperToolsVisibility}"
                          Click="OpenDeveloperToolMenuItem_Click" />
                <MenuItem Header="Analysis Reports"
                          Tag="Analysis Reports"
                          Visibility="{Binding DeveloperToolsVisibility}"
                          Click="OpenDeveloperToolMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="About / Credits"
                          Click="AboutMenuItem_Click" />
                <MenuItem Header="README / Documentation"
                          Click="OpenDocumentationMenuItem_Click" />
                <MenuItem Header="Backup Save Warning"
                          Click="BackupSaveWarningMenuItem_Click" />
            </MenuItem>
        </Menu>

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Background="{DynamicResource PanelBackgroundBrush}"
                Padding="8"
                Margin="8,4,8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="AttachButton"
                            Content="Attach / Rescan"
                            Click="AttachButton_Click" />
                    <Button x:Name="DetachButton"
                            Content="Detach"
                            IsEnabled="False"
                            Click="DetachButton_Click" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="18,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot"
                                 Width="10"
                                 Height="10"
                                 Fill="{DynamicResource StatusNeutralBrush}"
                                 Margin="0,0,8,0" />
                        <TextBlock x:Name="StatusText"
                                   Text="Not attached"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="18,4,0,0">
                        <TextBlock Text="Player Data:" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,4,0" />
                        <TextBlock x:Name="PlayerDataStateText"
                                   Text="Not Ready"
                                   FontWeight="SemiBold"
                                   Margin="0,0,14,0" />
                        <TextBlock Text="Inventory:" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,4,0" />
                        <TextBlock x:Name="InventoryStateText"
                                   Text="-"
                                   FontWeight="SemiBold"
                                   Margin="0,0,14,0" />
                        <TextBlock Text="Equipment:" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,4,0" />
                        <TextBlock x:Name="EquipmentStateText"
                                   Text="-"
                                   FontWeight="SemiBold"
                                   Margin="0,0,14,0" />
                        <TextBlock Text="Editing:" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,4,0" />
                        <TextBlock x:Name="OwnershipEditsStateText"
                                   Text="Unknown"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="Back up your save before using this trainer."
                               Foreground="{DynamicResource WarningTextBrush}"
                               FontWeight="SemiBold"
                               Margin="18,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding ApplicationTitle}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0" />
                        <CheckBox Content="Dark Mode"
                                  IsChecked="{Binding IsDarkMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,16,0" />
