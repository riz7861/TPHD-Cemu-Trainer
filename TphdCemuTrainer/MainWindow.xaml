                        </GroupBox>
                    </UniformGrid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Hidden Skills">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6">
                        <GroupBox Header="Hidden Skills Progression Editor">
                            <StackPanel>
                                <Border BorderBrush="{DynamicResource WarningBorderBrush}"
                                        BorderThickness="1"
                                        Background="{DynamicResource WarningBackgroundBrush}"
                                        Padding="8"
                                        Margin="0,0,0,8">
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{DynamicResource WarningTextBrush}"
                                               FontWeight="SemiBold"
                                               Text="Hidden Skills are progression-dependent. The in-game Skills menu may not reflect isolated flags correctly. This editor enforces safe sequential progression. Use copied saves first." />
                                </Border>

                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,0,8"
                                           Visibility="{Binding NormalModeVisibility}"
                                           Text="Enabling a skill automatically enables earlier skills; disabling one automatically disables later skills. Lesson progress is left unchanged." />
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,0,8"
                                           Visibility="{Binding DeveloperToolsVisibility}"
