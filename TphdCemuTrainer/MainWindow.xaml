                                    <Button Content="Inventory Slots"
                                            Click="ResearchPresetInventorySlots_Click" />
                                    <Button Content="Equipment/Ownership"
                                            Click="ResearchPresetEquipmentOwnership_Click" />
                                    <Button Content="Equipped Gear"
                                            Click="ResearchPresetEquippedGear_Click" />
                                </StackPanel>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="94" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="62" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="52" />
