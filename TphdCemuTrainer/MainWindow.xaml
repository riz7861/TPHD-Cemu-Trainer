                                <Grid Margin="0,4"
                                      Visibility="{Binding DeveloperToolsVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Total progression steps" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             x:Name="TotalHeartPiecesText"
                                             Text="Not read"
                                             IsReadOnly="True"
                                             Background="{DynamicResource ReadOnlyBackgroundBrush}" />
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Notes">
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="Choose the value you want, then select Set. If player data is not found, load into gameplay and rescan." />
                        </GroupBox>

                    </UniformGrid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Inventory">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <StackPanel Margin="6">
                        <StackPanel>
                            <GroupBox Header="Quick Actions / Status">
