                    <TextBlock Text="Developer Mode Enabled"
                               Visibility="{Binding DeveloperToolsVisibility}"
                               Foreground="{DynamicResource WarningTextBrush}"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                               Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Visibility="{Binding DeveloperToolsVisibility}"
                                Margin="0,4,0,0">
                        <TextBlock Text="PID:" Margin="0,0,4,0" />
                        <TextBlock x:Name="PidText"
                                   Text="-"
                                   FontWeight="SemiBold"
                                   Margin="0,0,16,0" />
                        <TextBlock Text="Player base:" Margin="0,0,4,0" />
                        <TextBlock x:Name="PlayerBaseText"
                                   Text="-"
                                   FontFamily="Consolas"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="2"
                    x:Name="TrainerTabs"
                    Background="{DynamicResource AppBackgroundBrush}"
                    Margin="8,0,8,8">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <UniformGrid Columns="2" Margin="6">
                        <GroupBox Header="Player">
                            <StackPanel>
                                <ContentControl Content="{Binding CurrentHealth}"
                                                ContentTemplate="{StaticResource HealthValueTemplate}" />
                                <ContentControl Content="{Binding MaximumHealth}"
                                                ContentTemplate="{StaticResource HealthValueTemplate}" />
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Heart containers" VerticalAlignment="Center" />
