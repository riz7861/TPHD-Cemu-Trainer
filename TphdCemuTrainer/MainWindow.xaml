                                     Margin="0,0,0,8" />

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="74" />
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" MinWidth="220" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Offset" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="Bit" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="Current" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="Desired" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="4" Text="Confirmed bug" FontWeight="SemiBold" Margin="6,0" />
                                <TextBlock Grid.Column="5" Text="Status" FontWeight="SemiBold" Margin="6,0" />
                                <TextBlock Grid.Column="6" Text="Assigned bug name" FontWeight="SemiBold" Margin="6,0" />
                                <TextBlock Grid.Column="7" Text="Notes" FontWeight="SemiBold" Margin="6,0" />
                                <TextBlock Grid.Column="8" Text="Last write" FontWeight="SemiBold" Margin="6,0" />
                            </Grid>

                            <ScrollViewer Height="320"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto"
                                          Background="{DynamicResource ReadOnlyBackgroundBrush}">
                                <ItemsControl ItemsSource="{Binding GoldenBugsBitRows}"
                                              ItemTemplate="{StaticResource GoldenBugBitRowTemplate}" />
                            </ScrollViewer>

                            <Expander Header="Golden Bugs Bitfield Testing Diagnostics" IsExpanded="False" Margin="0,8,0,0">
                                <ScrollViewer Height="160"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto"
                                              Background="{DynamicResource ReadOnlyBackgroundBrush}">
                                    <ItemsControl ItemsSource="{Binding GoldenBugsBitfieldDiagnostics}">
