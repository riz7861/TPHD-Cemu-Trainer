<Window x:Class="TphdCemuTrainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TPHD Cemu Trainer"
        Height="760"
        MinHeight="680"
        Width="1120"
        MinWidth="980"
        Background="#F0F0F0"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="3,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="25" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="25" />
            <Setter Property="MinWidth" Value="98" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="7" />
            <Setter Property="Padding" Value="9" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="12,5" />
        </Style>

        <DataTemplate x:Key="EditableValueTemplate">
            <Grid Margin="0,4" ToolTip="{Binding Source}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="135" />
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="82" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding Name}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <TextBox Grid.Column="1"
                         Text="{Binding CurrentValue, Mode=OneWay}"
                         IsReadOnly="True"
                         Background="#F7F7F7" />
                <TextBox Grid.Column="2"
                         Text="{Binding TargetValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Margin="6,0,0,0" />
                <Button Grid.Column="3"
                        Content="Set"
                        Tag="{Binding}"
                        Click="SetValue_Click" />
                <Button Grid.Column="4"
                        Content="Max"
                        Tag="{Binding}"
                        Click="MaxValue_Click" />
                <CheckBox Grid.Column="5"
                          Content="{Binding LockText}"
                          IsChecked="{Binding IsLocked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          IsEnabled="{Binding CanLock}"
                          VerticalAlignment="Center"
                          Margin="6,0,0,0" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ReadOnlyRawValueTemplate">
            <Grid Margin="0,3" ToolTip="{Binding Source}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="135" />
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="112" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Offset}"
                           FontFamily="Consolas"
                           VerticalAlignment="Center" />
                <TextBox Grid.Column="2"
                         Text="{Binding CurrentValue, Mode=OneWay}"
                         IsReadOnly="True"
                         Background="#F7F7F7" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CapacityTemplate">
            <Grid Margin="0,4" ToolTip="{Binding Source}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="135" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="130" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Options}"
                          DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          SelectionChanged="CapacityCombo_SelectionChanged"
                          Tag="{Binding}" />
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           Foreground="#555">
                    <Run Text="Stored:" />
                    <Run Text="{Binding CurrentStoredValue, Mode=OneWay}" />
                </TextBlock>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FutureCheckTemplate">
            <CheckBox Content="{Binding Name}"
                      IsEnabled="False"
                      ToolTip="{Binding Notes}"
                      Margin="0,3" />
        </DataTemplate>

        <DataTemplate x:Key="FutureTextTemplate">
            <TextBlock Text="{Binding Name}"
                       ToolTip="{Binding Notes}"
                       Margin="0,3"
                       Foreground="#555" />
        </DataTemplate>

        <DataTemplate x:Key="InventorySlotTemplate">
            <Border BorderBrush="#D8D8D8"
                    BorderThickness="0,0,0,1"
                    Padding="0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="*" MinWidth="150" />
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="62" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding SlotNumber}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Offset}"
                               FontFamily="Consolas"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding CurrentItemId, Mode=OneWay}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding CurrentItemName, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4"
                               Text="{Binding ManagementStatus}"
                               Foreground="#7A4A00"
                               VerticalAlignment="Center"
                               Margin="6,0" />
                    <ComboBox Grid.Column="5"
                              ItemsSource="{Binding AvailableItems}"
                              DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Margin="6,0" />
                    <Button Grid.Column="6"
                            Content="Apply"
                            IsEnabled="{Binding CanEdit}"
                            Tag="{Binding}"
                            Click="ApplyInventorySlot_Click" />
                    <Button Grid.Column="7"
                            Content="Clear"
                            IsEnabled="{Binding CanEdit}"
                            Tag="{Binding}"
                            Click="ClearInventorySlot_Click" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="InventoryFixedSlotTemplate">
            <Border BorderBrush="#D8D8D8"
                    BorderThickness="0,0,0,1"
                    Padding="0,5"
                    ToolTip="{Binding Notes}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="*" MinWidth="150" />
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="112" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding Name}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding SlotNumber}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding Offset}"
                               FontFamily="Consolas"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding CurrentItemId, Mode=OneWay}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4"
                               Text="{Binding CurrentItemName, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <ComboBox Grid.Column="5"
                              ItemsSource="{Binding AllowedItems}"
                              DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Margin="6,0" />
                    <Button Grid.Column="6"
                            Content="Apply"
                            IsEnabled="{Binding CanEdit}"
                            Tag="{Binding}"
                            Click="ApplyFixedInventoryItem_Click" />
                    <TextBlock Grid.Column="7"
                               Text="{Binding ManagementStatus}"
                               Foreground="#7A4A00"
                               VerticalAlignment="Center"
                               Margin="6,0" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="EquipmentSlotTemplate">
            <Border BorderBrush="#D8D8D8"
                    BorderThickness="0,0,0,1"
                    Padding="0,5"
                    ToolTip="{Binding Source}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="*" MinWidth="150" />
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding Name}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Offset}"
                               FontFamily="Consolas"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding CurrentValue, Mode=OneWay}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding CurrentName, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <ComboBox Grid.Column="4"
                              ItemsSource="{Binding Options}"
                              DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding SelectedOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Margin="6,0" />
                    <Button Grid.Column="5"
                            Content="Apply"
                            IsEnabled="{Binding CanEdit}"
                            Tag="{Binding}"
                            Click="ApplyEquippedEquipment_Click" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="EquipmentFlagTemplate">
            <Border BorderBrush="#D8D8D8"
                    BorderThickness="0,0,0,1"
                    Padding="0,5"
                    ToolTip="{Binding Source}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="180" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Content="{Binding Name}"
                              IsChecked="{Binding IsOwned, Mode=OneWay}"
                              IsEnabled="{Binding CanEdit}"
                              Tag="{Binding}"
                              Click="EquipmentFlag_Click"
                              VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Offset}"
                               FontFamily="Consolas"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding Bit}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding BackingValue, Mode=OneWay}"
                               FontFamily="Consolas"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="#B8B8B8"
                BorderThickness="1"
                Background="#FAFAFA"
                Padding="9"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="AttachButton"
                            Content="Attach / Rescan"
                            Click="AttachButton_Click" />
                    <Button x:Name="DetachButton"
                            Content="Detach"
                            IsEnabled="False"
                            Click="DetachButton_Click" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="18,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot"
                                 Width="10"
                                 Height="10"
                                 Fill="#808080"
                                 Margin="0,0,8,0" />
                        <TextBlock x:Name="StatusText"
                                   Text="Not attached"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="18,4,0,0">
                        <TextBlock Text="Player Data:" Foreground="#555" Margin="0,0,4,0" />
                        <TextBlock x:Name="PlayerDataStateText"
                                   Text="Not Ready"
                                   FontWeight="SemiBold"
                                   Margin="0,0,14,0" />
                        <TextBlock Text="Inventory:" Foreground="#555" Margin="0,0,4,0" />
                        <TextBlock x:Name="InventoryStateText"
                                   Text="-"
                                   FontWeight="SemiBold"
                                   Margin="0,0,14,0" />
                        <TextBlock Text="Equipment:" Foreground="#555" Margin="0,0,4,0" />
                        <TextBlock x:Name="EquipmentStateText"
                                   Text="-"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="PID:" Margin="0,0,4,0" />
                    <TextBlock x:Name="PidText"
                               Text="-"
                               FontWeight="SemiBold"
                               Margin="0,0,16,0" />
                    <TextBlock Text="Player base:" Margin="0,0,4,0" />
                    <TextBlock x:Name="PlayerBaseText"
                               Text="-"
                               FontFamily="Consolas"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1"
                    x:Name="TrainerTabs"
                    Background="#F0F0F0">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <UniformGrid Columns="2" Margin="6">
                        <GroupBox Header="Player">
                            <StackPanel>
                                <ContentControl Content="{Binding CurrentHealth}"
                                                ContentTemplate="{StaticResource EditableValueTemplate}" />
                                <ContentControl Content="{Binding MaximumHealth}"
                                                ContentTemplate="{StaticResource EditableValueTemplate}" />
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Heart containers" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             x:Name="HeartContainersText"
                                             Text="Not read"
                                             IsReadOnly="True"
                                             Background="#F7F7F7" />
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Heart pieces" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             x:Name="TotalHeartPiecesText"
                                             Text="Not mapped in CT"
                                             IsReadOnly="True"
                                             Background="#F7F7F7" />
                                </Grid>
                                <ContentControl Content="{Binding LanternOil}"
                                                ContentTemplate="{StaticResource EditableValueTemplate}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Wallet">
                            <StackPanel>
                                <ContentControl Content="{Binding WalletCapacity}"
                                                ContentTemplate="{StaticResource CapacityTemplate}" />
                                <ContentControl Content="{Binding Rupees}"
                                                ContentTemplate="{StaticResource EditableValueTemplate}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Collectibles Summary">
                            <StackPanel>
                                <ContentControl Content="{Binding PoeSouls}"
                                                ContentTemplate="{StaticResource EditableValueTemplate}" />
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Golden Bugs count" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             x:Name="GoldenBugsCountText"
                                             Text="Not read"
                                             IsReadOnly="True"
                                             Background="#F7F7F7" />
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Total Heart Pieces" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding ElementName=TotalHeartPiecesText, Path=Text, Mode=OneWay}"
                                             IsReadOnly="True"
                                             Background="#F7F7F7" />
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Notes">
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="#555"
                                       Text="Capacity-limited edits are clamped to the selected capacity before writing. If player data is not found, load into gameplay and rescan." />
                        </GroupBox>
                    </UniformGrid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Inventory">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6">
                        <GroupBox Header="Inventory Items">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="#7A4A00"
                                           Margin="0,0,0,8"
                                           Text="Use item-specific editors when available. The raw 24 inventory bytes appear to be fixed/game-managed slots, not arbitrary bag slots." />

                                <Border x:Name="InventoryInitializationWarningText"
                                        Visibility="Collapsed"
                                        BorderBrush="#D9A23A"
                                        BorderThickness="1"
                                        Background="#FFF8E6"
                                        Padding="8"
                                        Margin="0,0,0,8">
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="#6F4700"
                                               FontWeight="SemiBold"
                                               Text="Inventory has not been initialized by the game yet.&#x0a;&#x0a;You appear to be at a very early point in the story.&#x0a;&#x0a;Progress until Link obtains a real inventory item (Fishing Rod, Slingshot, Lantern, etc.) then click Attach / Rescan." />
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="Refresh Inventory"
                                            Click="RefreshInventoryButton_Click" />
                                    <TextBlock Text="Known fixed-slot editors restrict choices to variants that belong in that slot."
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0"
                                               Foreground="#555" />
                                </StackPanel>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="54" />
                                        <ColumnDefinition Width="74" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="*" MinWidth="150" />
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="112" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Item" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Slot" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="Offset" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Item ID" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="4" Text="Current item" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="5" Text="Allowed variant" FontWeight="SemiBold" Margin="6,0" />
                                    <TextBlock Grid.Column="7" Text="Status" FontWeight="SemiBold" Margin="6,0" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding FixedInventoryItems}"
                                              ItemTemplate="{StaticResource InventoryFixedSlotTemplate}" />

                                <GroupBox Header="Advanced diagnostics" Margin="0,0,0,8">
                                    <StackPanel>
                                        <CheckBox Content="Hold inventory value for 2 seconds after Apply"
                                                  IsChecked="{Binding HoldInventoryValueAfterApply, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="Repeats the selected byte write for two seconds after Apply to test whether the game is overwriting the slot."
                                                  Margin="0,2" />
                                        <CheckBox Content="Allow editing uninitialized inventory"
                                                  IsChecked="{Binding AllowEditingUninitializedInventory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="Allows Apply/Clear while all 24 CT inventory slots read as 255 / Nothing."
                                                  Margin="0,4,0,2" />
                                    </StackPanel>
                                </GroupBox>

                                <Expander Header="Advanced / Raw Inventory (Unsafe)" IsExpanded="False">
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock TextWrapping="Wrap"
                                                   Foreground="#7A4A00"
                                                   Margin="0,0,0,8"
                                                   Text="Raw mode exposes all CT item IDs for diagnostics. These are not arbitrary free inventory slots; game-managed slots may revert and should use a specific item editor when one exists." />

                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="54" />
                                                <ColumnDefinition Width="74" />
                                                <ColumnDefinition Width="92" />
                                                <ColumnDefinition Width="*" MinWidth="150" />
                                                <ColumnDefinition Width="112" />
                                                <ColumnDefinition Width="260" />
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="62" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Slot" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="Offset" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="2" Text="Item ID" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="3" Text="Current item" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="4" Text="Status" FontWeight="SemiBold" Margin="6,0" />
                                            <TextBlock Grid.Column="5" Text="Replacement item" FontWeight="SemiBold" Margin="6,0" />
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding InventorySlots}"
                                                      ItemTemplate="{StaticResource InventorySlotTemplate}" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Equipment">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6">
                        <GroupBox Header="Equipment Editor">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="#7A4A00"
                                           Margin="0,0,0,8"
                                           Text="Equipment values and ownership flags are CT-derived bytes. Uninitialized structures or active game state can reject writes." />

                                <Border x:Name="EquipmentInitializationWarningText"
                                        Visibility="Collapsed"
                                        BorderBrush="#D9A23A"
                                        BorderThickness="1"
                                        Background="#FFF8E6"
                                        Padding="8"
                                        Margin="0,0,0,8">
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="#6F4700"
                                               FontWeight="SemiBold"
                                               Text="Equipment has not been initialized by the game yet.&#x0a;&#x0a;Progress until Link obtains equipment, then click Attach / Rescan." />
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="Refresh Equipment"
                                            Click="RefreshEquipmentButton_Click" />
                                    <CheckBox Content="Advanced equipment editing"
                                              IsChecked="{Binding AdvancedEquipmentEditing, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="Enables explicit writes to equipped gear bytes and ownership flag bits."
                                              VerticalAlignment="Center"
                                              Margin="12,0,0,0" />
                                    <CheckBox Content="Allow editing uninitialized equipment"
                                              IsChecked="{Binding AllowEditingUninitializedEquipment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="Allows equipment writes while the CT equipment bytes appear uninitialized."
                                              VerticalAlignment="Center"
                                              Margin="12,0,0,0" />
                                    <TextBlock Text="Writes are disabled until advanced editing is enabled."
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"
                                               Foreground="#555" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Equipped Gear">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="*" MinWidth="150" />
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Slot" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Offset" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="Value" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Current" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="4" Text="Replacement" FontWeight="SemiBold" Margin="6,0" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding EquipmentSlots}"
                                              ItemTemplate="{StaticResource EquipmentSlotTemplate}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Ownership Flags">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="#555"
                                           Margin="0,0,0,8"
                                           Text="Flag checkboxes write individual CT bit values inside their backing bytes. They remain disabled until Advanced equipment editing is enabled." />
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="180" />
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Owned" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Offset" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="Bit" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Byte" FontWeight="SemiBold" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding EquipmentFlags}"
                                              ItemTemplate="{StaticResource EquipmentFlagTemplate}" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Ammo &amp; Upgrades">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <UniformGrid Columns="2" Margin="6">
                        <GroupBox Header="Wallet">
                            <StackPanel>
                                <ContentControl Content="{Binding WalletCapacity}"
                                                ContentTemplate="{StaticResource CapacityTemplate}" />
                                <ContentControl Content="{Binding Rupees}"
                                                ContentTemplate="{StaticResource EditableValueTemplate}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Quiver">
                            <StackPanel>
                                <ContentControl Content="{Binding QuiverCapacity}"
                                                ContentTemplate="{StaticResource CapacityTemplate}" />
                                <ContentControl Content="{Binding Arrows}"
                                                ContentTemplate="{StaticResource EditableValueTemplate}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Bomb Bag 1">
                            <StackPanel>
                                <ContentControl Content="{Binding BombBagCapacity}"
                                                ContentTemplate="{StaticResource CapacityTemplate}" />
                                <ContentControl Content="{Binding BombSlot1}"
                                                ContentTemplate="{StaticResource EditableValueTemplate}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Bomb Bag 2">
                            <StackPanel>
                                <ContentControl Content="{Binding BombBagCapacity}"
                                                ContentTemplate="{StaticResource CapacityTemplate}" />
                                <ContentControl Content="{Binding BombSlot2}"
                                                ContentTemplate="{StaticResource EditableValueTemplate}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Bomb Bag 3">
                            <StackPanel>
                                <ContentControl Content="{Binding BombBagCapacity}"
                                                ContentTemplate="{StaticResource CapacityTemplate}" />
                                <ContentControl Content="{Binding BombSlot3}"
                                                ContentTemplate="{StaticResource EditableValueTemplate}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Seed Bag">
                            <StackPanel>
                                <ContentControl Content="{Binding SeedBagCapacity}"
                                                ContentTemplate="{StaticResource CapacityTemplate}" />
                                <ContentControl Content="{Binding Seeds}"
                                                ContentTemplate="{StaticResource EditableValueTemplate}" />
                            </StackPanel>
                        </GroupBox>
                    </UniformGrid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Collectibles">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <UniformGrid Columns="2" Margin="6">
                        <GroupBox Header="Poe Souls">
                            <ContentControl Content="{Binding PoeSouls}"
                                            ContentTemplate="{StaticResource EditableValueTemplate}" />
                        </GroupBox>
                        <GroupBox Header="Golden Bugs">
                            <StackPanel>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Collected" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding ElementName=GoldenBugsCountText, Path=Text, Mode=OneWay}"
                                             IsReadOnly="True"
                                             Background="#F7F7F7" />
                                </Grid>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="#555"
                                           Text="Individual bug tracking is reserved for a future save-editor pass." />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Heart Pieces">
                            <TextBox Text="{Binding ElementName=TotalHeartPiecesText, Path=Text, Mode=OneWay}"
                                     IsReadOnly="True"
                                     Background="#F7F7F7" />
                        </GroupBox>
                        <GroupBox Header="Heart Containers">
                            <TextBox x:Name="CollectiblesHeartContainersText"
                                     Text="Not read"
                                     IsReadOnly="True"
                                     Background="#F7F7F7" />
                        </GroupBox>
                    </UniformGrid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Story Flags">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <UniformGrid Columns="2" Margin="6">
                        <GroupBox Header="Story Progression">
                            <ItemsControl ItemsSource="{Binding StoryFlags}"
                                          ItemTemplate="{StaticResource FutureCheckTemplate}" />
                        </GroupBox>
                        <GroupBox Header="Warning">
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="#555"
                                       Text="Story flags can affect progression and event state. This area is intentionally reserved until flag behavior is verified." />
                        </GroupBox>
                    </UniformGrid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Hidden Skills">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <GroupBox Header="Skills" Margin="13">
                        <ItemsControl ItemsSource="{Binding HiddenSkills}"
                                      ItemTemplate="{StaticResource FutureCheckTemplate}" />
                    </GroupBox>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Quest Items">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <UniformGrid Columns="2" Margin="6">
                        <GroupBox Header="Quest Items">
                            <ItemsControl ItemsSource="{Binding QuestItems}"
                                          ItemTemplate="{StaticResource FutureCheckTemplate}" />
                        </GroupBox>
                        <GroupBox Header="Progression Notes">
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="#555"
                                       Text="Quest item editing will be added after item state, event flags, and save compatibility are mapped." />
                        </GroupBox>
                    </UniformGrid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Debug">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <UniformGrid Columns="2" Margin="6">
                        <GroupBox Header="Current Player Base">
                            <StackPanel>
                                <TextBox x:Name="DebugPlayerBaseText"
                                         Text="-"
                                         IsReadOnly="True"
                                         FontFamily="Consolas"
                                         Background="#F7F7F7" />
                                <TextBlock Text="AOB pattern"
                                           Margin="0,10,0,2" />
                                <TextBox x:Name="AobPatternText"
                                         IsReadOnly="True"
                                         FontFamily="Consolas"
                                         TextWrapping="Wrap"
                                         Background="#F7F7F7" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Progression Diagnostics">
                            <StackPanel>
                                <TextBlock Text="Also written to logs/progression.log after Attach / Rescan"
                                           Foreground="#555"
                                           Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Player base" VerticalAlignment="Center" Margin="0,0,8,5" />
                                    <TextBox Grid.Column="1"
                                             x:Name="ProgressionPlayerBaseText"
                                             Text="-"
                                             IsReadOnly="True"
                                             FontFamily="Consolas"
                                             Background="#F7F7F7"
                                             Margin="0,0,0,5" />

                                    <TextBlock Grid.Row="1" Text="Inventory" VerticalAlignment="Center" Margin="0,0,8,5" />
                                    <TextBox Grid.Row="1"
                                             Grid.Column="1"
                                             x:Name="ProgressionInventoryInitializedText"
                                             Text="-"
                                             IsReadOnly="True"
                                             Background="#F7F7F7"
                                             Margin="0,0,0,5" />

                                    <TextBlock Grid.Row="2" Text="Equipment" VerticalAlignment="Center" Margin="0,0,8,5" />
                                    <TextBox Grid.Row="2"
                                             Grid.Column="1"
                                             x:Name="ProgressionEquipmentInitializedText"
                                             Text="-"
                                             IsReadOnly="True"
                                             Background="#F7F7F7"
                                             Margin="0,0,0,5" />

                                    <TextBlock Grid.Row="3" Text="Inventory raw bytes" VerticalAlignment="Center" Margin="0,0,8,5" />
                                    <TextBox Grid.Row="3"
                                             Grid.Column="1"
                                             x:Name="ProgressionInventoryRawBytesText"
                                             Text="Not read"
                                             IsReadOnly="True"
                                             FontFamily="Consolas"
                                             TextWrapping="Wrap"
                                             Background="#F7F7F7"
                                             Margin="0,0,0,5" />

                                    <TextBlock Grid.Row="4" Text="Ownership bytes" VerticalAlignment="Center" Margin="0,0,8,5" />
                                    <TextBox Grid.Row="4"
                                             Grid.Column="1"
                                             x:Name="ProgressionEquipmentOwnershipBytesText"
                                             Text="Not read"
                                             IsReadOnly="True"
                                             FontFamily="Consolas"
                                             Background="#F7F7F7"
                                             Margin="0,0,0,5" />

                                    <TextBlock Grid.Row="5" Text="Equipped bytes" VerticalAlignment="Center" Margin="0,0,8,5" />
                                    <TextBox Grid.Row="5"
                                             Grid.Column="1"
                                             x:Name="ProgressionEquipmentEquippedBytesText"
                                             Text="Not read"
                                             IsReadOnly="True"
                                             FontFamily="Consolas"
                                             Background="#F7F7F7"
                                             Margin="0,0,0,5" />

                                    <TextBlock Grid.Row="6" Text="Current status" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox Grid.Row="6"
                                             Grid.Column="1"
                                             x:Name="ProgressionStatusMessageText"
                                             Text="Not attached"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             Background="#F7F7F7" />
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Raw Memory Values">
                            <ItemsControl ItemsSource="{Binding RawMemoryValues}"
                                          ItemTemplate="{StaticResource ReadOnlyRawValueTemplate}" />
                        </GroupBox>

                        <GroupBox Header="Inventory Diagnostics">
                            <StackPanel>
                                <TextBlock Text="Also written to logs/inventory.log"
                                           Foreground="#555"
                                           Margin="0,0,0,6" />
                                <ScrollViewer Height="190"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto"
                                              Background="#F7F7F7">
                                    <ItemsControl ItemsSource="{Binding InventoryDiagnostics}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           TextWrapping="NoWrap"
                                                           Margin="0,0,0,4" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Equipment Diagnostics">
                            <StackPanel>
                                <TextBlock Text="Also written to logs/equipment.log"
                                           Foreground="#555"
                                           Margin="0,0,0,6" />
                                <ScrollViewer Height="190"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto"
                                              Background="#F7F7F7">
                                    <ItemsControl ItemsSource="{Binding EquipmentDiagnostics}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           TextWrapping="NoWrap"
                                                           Margin="0,0,0,4" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Advanced Tools">
                            <ItemsControl ItemsSource="{Binding DebugTools}"
                                          ItemTemplate="{StaticResource FutureTextTemplate}" />
                        </GroupBox>

                        <GroupBox Header="Coordinate Display">
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="#555"
                                       Text="Coordinate display and teleport tools are reserved for a future coordinate-base scan implementation." />
                        </GroupBox>
                    </UniformGrid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
