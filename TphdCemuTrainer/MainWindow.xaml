        <DataTemplate x:Key="ResearchSnapshotCompareRowTemplate">
            <Border BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="0,4">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ChangedRowBackgroundBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" MinWidth="110" />
                        <ColumnDefinition Width="*" MinWidth="110" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Offset}" FontFamily="Consolas" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding SnapshotAByte}" FontFamily="Consolas" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding SnapshotBByte}" FontFamily="Consolas" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding Difference}" FontFamily="Consolas" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{Binding SnapshotADecode}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="5" Text="{Binding SnapshotBDecode}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="6" Text="{Binding IsChanged}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="OwnershipDiscoveryBitTemplate">
            <Border Width="14"
                    Margin="0,0,1,0"
                    Padding="1,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ChangedBitBackgroundBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Value}"
                           ToolTip="{Binding ToolTip}"
                           TextAlignment="Center"
                           FontFamily="Consolas" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="OwnershipDiscoveryRowTemplate">
            <Border BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="0,4">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ChangedRowBackgroundBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsStrongCandidate}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource StrongCandidateBackgroundBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="118" />
                        <ColumnDefinition Width="118" />
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" MinWidth="260" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Offset}" FontFamily="Consolas" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding BeforeByte}" FontFamily="Consolas" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding AfterByte}" FontFamily="Consolas" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding ByteChanged}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ItemsControl Grid.Column="4"
                                  ItemsSource="{Binding BeforeBitCells}"
                                  ItemTemplate="{StaticResource OwnershipDiscoveryBitTemplate}"
                                  VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <ItemsControl Grid.Column="5"
                                  ItemsSource="{Binding AfterBitCells}"
                                  ItemTemplate="{StaticResource OwnershipDiscoveryBitTemplate}"
                                  VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Grid.Column="6" Text="{Binding ChangedBits}" FontFamily="Consolas" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="7" Text="{Binding ChangedBitCount}" FontFamily="Consolas" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="8" Text="{Binding Score}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="9" Text="{Binding PotentialMeaning}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="OwnershipCorrelationRowTemplate">
            <Border BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" MinWidth="240" />
                        <ColumnDefinition Width="*" MinWidth="240" />
                        <ColumnDefinition Width="*" MinWidth="320" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Offset}" FontFamily="Consolas" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding ChangedCount}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding AssociatedItemGains}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding BitChanges}" TextTrimming="CharacterEllipsis" FontFamily="Consolas" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{Binding Reports}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Background="{DynamicResource PanelBackgroundBrush}"
                Padding="9"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="AttachButton"
                            Content="Attach / Rescan"
                            Click="AttachButton_Click" />
                    <Button x:Name="DetachButton"
                            Content="Detach"
                            IsEnabled="False"
                            Click="DetachButton_Click" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="18,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot"
                                 Width="10"
                                 Height="10"
                                 Fill="{DynamicResource StatusNeutralBrush}"
                                 Margin="0,0,8,0" />
                        <TextBlock x:Name="StatusText"
                                   Text="Not attached"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="18,4,0,0">
                        <TextBlock Text="Player Data:" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,4,0" />
                        <TextBlock x:Name="PlayerDataStateText"
                                   Text="Not Ready"
                                   FontWeight="SemiBold"
                                   Margin="0,0,14,0" />
                        <TextBlock Text="Inventory:" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,4,0" />
                        <TextBlock x:Name="InventoryStateText"
                                   Text="-"
                                   FontWeight="SemiBold"
                                   Margin="0,0,14,0" />
                        <TextBlock Text="Equipment:" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,4,0" />
                        <TextBlock x:Name="EquipmentStateText"
                                   Text="-"
                                   FontWeight="SemiBold"
                                   Margin="0,0,14,0" />
                        <TextBlock Text="Ownership Edits:" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,4,0" />
                        <TextBlock x:Name="OwnershipEditsStateText"
                                   Text="Unknown"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <CheckBox Content="Dark Mode"
                              IsChecked="{Binding IsDarkMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              VerticalAlignment="Center"
                              Margin="0,0,16,0" />
                    <TextBlock Text="PID:" Margin="0,0,4,0" />
                    <TextBlock x:Name="PidText"
                               Text="-"
                               FontWeight="SemiBold"
                               Margin="0,0,16,0" />
                    <TextBlock Text="Player base:" Margin="0,0,4,0" />
                    <TextBlock x:Name="PlayerBaseText"
                               Text="-"
                               FontFamily="Consolas"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1"
                    x:Name="TrainerTabs"
                    Background="{DynamicResource AppBackgroundBrush}">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <UniformGrid Columns="2" Margin="6">
                        <GroupBox Header="Player">
                            <StackPanel>
                                <ContentControl Content="{Binding CurrentHealth}"
                                                ContentTemplate="{StaticResource EditableValueTemplate}" />
                                <ContentControl Content="{Binding MaximumHealth}"
                                                ContentTemplate="{StaticResource EditableValueTemplate}" />
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Heart containers" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             x:Name="HeartContainersText"
                                             Text="Not read"
                                             IsReadOnly="True"
                                             Background="{DynamicResource ReadOnlyBackgroundBrush}" />
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Heart pieces" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             x:Name="TotalHeartPiecesText"
                                             Text="Not mapped in CT"
                                             IsReadOnly="True"
                                             Background="{DynamicResource ReadOnlyBackgroundBrush}" />
                                </Grid>
                                <ContentControl Content="{Binding LanternOil}"
                                                ContentTemplate="{StaticResource EditableValueTemplate}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Wallet">
                            <StackPanel>
                                <ContentControl Content="{Binding WalletCapacity}"
                                                ContentTemplate="{StaticResource CapacityTemplate}" />
                                <ContentControl Content="{Binding Rupees}"
                                                ContentTemplate="{StaticResource EditableValueTemplate}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Collectibles Summary">
                            <StackPanel>
                                <ContentControl Content="{Binding PoeSouls}"
                                                ContentTemplate="{StaticResource PoeSoulsValueTemplate}" />
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Golden Bugs count" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             x:Name="GoldenBugsCountText"
                                             Text="Not read"
                                             IsReadOnly="True"
                                             Background="{DynamicResource ReadOnlyBackgroundBrush}" />
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Total Heart Pieces" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding ElementName=TotalHeartPiecesText, Path=Text, Mode=OneWay}"
                                             IsReadOnly="True"
                                             Background="{DynamicResource ReadOnlyBackgroundBrush}" />
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Notes">
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="Capacity-limited edits are clamped to the selected capacity before writing. If player data is not found, load into gameplay and rescan." />
                        </GroupBox>
                    </UniformGrid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Inventory">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6">
                        <GroupBox Header="Owned / Unlocked Inventory Items">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{DynamicResource WarningTextBrush}"
                                           Margin="0,0,0,8"
                                           Text="Inventory ownership/progression flags have not been mapped yet. Known items are detected from visible inventory data. The fixed-slot editor below edits visible slots only; it does not set story progression." />

                                <Border BorderBrush="{DynamicResource WarningBorderBrush}"
                                        BorderThickness="1"
                                        Background="{DynamicResource WarningBackgroundBrush}"
                                        Padding="8"
                                        Margin="0,0,0,8">
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{DynamicResource WarningTextBrush}"
                                               FontWeight="SemiBold"
                                               Text="This edits fixed visible inventory slots, not story progression. Some items may appear but be unusable until story flags or related state are set. Button assignments are separate from inventory slots." />
                                </Border>

                                <Border BorderBrush="{DynamicResource WarningBorderBrush}"
                                        BorderThickness="1"
                                        Background="{DynamicResource WarningBackgroundBrush}"
                                        Padding="8"
                                        Margin="0,0,0,8">
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{DynamicResource WarningTextBrush}"
                                               FontWeight="SemiBold"
                                               Text="Fixed-slot inventory changes may not appear if the in-game inventory menu is already open. Close and reopen the inventory menu after applying changes." />
                                </Border>

                                <Border x:Name="InventoryOwnershipAcceptanceWarningText"
                                        Visibility="Collapsed"
                                        BorderBrush="{DynamicResource WarningBorderBrush}"
                                        BorderThickness="1"
                                        Background="{DynamicResource WarningBackgroundBrush}"
                                        Padding="8"
                                        Margin="0,0,0,8">
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{DynamicResource WarningTextBrush}"
                                               FontWeight="SemiBold"
                                               Text="This save appears to be before TPHD begins honoring ownership edits. Progress past the Ordon Village intro arc and rescan." />
                                </Border>

                                <Border x:Name="InventoryInitializationWarningText"
                                        Visibility="Collapsed"
                                        BorderBrush="{DynamicResource WarningBorderBrush}"
                                        BorderThickness="1"
                                        Background="{DynamicResource WarningBackgroundBrush}"
                                        Padding="8"
                                        Margin="0,0,0,8">
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{DynamicResource WarningTextBrush}"
                                               FontWeight="SemiBold"
                                               Text="Inventory has not been initialized by the game yet.&#x0a;&#x0a;You appear to be at a very early point in the story.&#x0a;&#x0a;Progress until Link obtains a real inventory item (Fishing Rod, Slingshot, Lantern, etc.) then click Attach / Rescan." />
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="Refresh Inventory"
                                            Click="RefreshInventoryButton_Click" />
                                    <Button x:Name="ApplyInventoryOwnershipButton"
                                            Content="Apply Inventory Ownership Changes"
                                            Click="ApplyInventoryOwnership_Click"
                                            Margin="12,0,0,0" />
                                    <TextBlock Text="Visible inventory slots are game-managed and read-only."
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>

                                <WrapPanel Margin="0,0,0,8">
                                    <CheckBox Content="I am past the Ordon Village intro arc"
                                              IsChecked="{Binding UserConfirmedPastIntroArc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="Uses a manual override for the ownership-edit acceptance heuristic."
                                              VerticalAlignment="Center"
                                              Margin="0,0,18,6" />
                                    <CheckBox Content="Allow ownership edits before intro completion"
                                              IsChecked="{Binding AllowOwnershipEditsBeforeIntroCompletion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="Bypasses the conservative early-save guard for mapped ownership flags."
                                              VerticalAlignment="Center"
                                              Margin="0,0,18,6" />
                                </WrapPanel>

                                <Border BorderBrush="{DynamicResource WarningBorderBrush}"
                                        BorderThickness="1"
                                        Background="{DynamicResource WarningBackgroundBrush}"
                                        Padding="8"
                                        Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock TextWrapping="Wrap"
                                                   Foreground="{DynamicResource WarningTextBrush}"
                                                   FontWeight="SemiBold"
                                                   Text="Fixed Slot Inventory Editor / Experimental. Checked writes the row's detected or static fixed-slot item ID to its fixed visible slot. Unchecked writes 0xFF / Nothing to remove it. This is not solved ownership and may revert or fail to appear in-game if related progression state is missing." />
                                        <TextBlock TextWrapping="Wrap"
                                                   Foreground="{DynamicResource WarningTextBrush}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,6,0,0"
                                                   Text="Use only one Clawshot variant. Enabling both can hide or displace another progression item such as the Dominion Rod." />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <CheckBox Content="Enable fixed-slot inventory editor / experimental"
                                                      IsChecked="{Binding EnableExperimentalInventoryCheckboxWrites, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,12,0" />
                                            <Button x:Name="ApplyInventoryCheckboxTestingButton"
                                                    Content="Apply Fixed-Slot Inventory Changes"
                                                    Click="ApplyInventoryCheckboxTesting_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="210" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="74" />
                                        <ColumnDefinition Width="54" />
