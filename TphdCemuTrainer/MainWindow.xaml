                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Items">
                                <StackPanel>
                                    <Grid Margin="4,0,4,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="190" />
