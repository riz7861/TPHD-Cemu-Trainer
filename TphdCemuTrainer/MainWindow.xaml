                                               FontWeight="SemiBold"
                                               Margin="6,0" />
                                    <TextBlock Grid.Column="7"
                                               Text="Last verification"
                                               Visibility="{Binding DeveloperToolsVisibility}"
                                               FontWeight="SemiBold"
                                               Margin="6,0" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding HiddenSkillsEditorRows}"
                                              ItemTemplate="{StaticResource HiddenSkillEditorTemplate}" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Quest Items">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <StackPanel Margin="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="420" />
                                <ColumnDefinition Width="*" MinWidth="420" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <GroupBox Header="Quest / Special Items">
                                    <StackPanel>
                                        <Grid Margin="4,0,4,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="180" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="70" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Item" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="Current" FontWeight="SemiBold" />
