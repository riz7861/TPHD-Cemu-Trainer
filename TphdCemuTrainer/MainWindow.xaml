                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="74" />
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" MinWidth="220" />
