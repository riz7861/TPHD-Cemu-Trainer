                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,0,8"
                                           Text="Research only. Capture before and after quest progression to locate candidate storage for Fused Shadows, Mirror Shards, Sky Book/Sky Characters, Dominion Rod progression, Horse Call, Ashei quest chain items, Invoice/Wooden Statue chain, and other quest state. This feature does not write memory." />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="94" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="62" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Capture Label"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                    <TextBox Grid.Column="1"
                                             x:Name="QuestItemsCaptureLabelText"
                                             Margin="0,0,8,0"
                                             ToolTip="Used in persistent quest-capture filenames and report names." />
                                    <TextBlock Grid.Column="2"
                                               Text="Notes"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                    <TextBox Grid.Column="3"
                                             x:Name="QuestItemsCaptureNotesText"
                                             MinHeight="26"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             ToolTip="Optional notes saved with persistent Quest Items captures." />
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="94" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Capture Type"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                    <ComboBox Grid.Column="1"
                                              x:Name="QuestItemsCaptureTypeComboBox"
                                              SelectedIndex="0"
                                              Margin="0,0,8,0">
                                        <ComboBoxItem Content="Forest Temple" />
                                        <ComboBoxItem Content="Goron Mines" />
                                        <ComboBoxItem Content="Lakebed Temple" />
                                        <ComboBoxItem Content="Arbiter's Grounds" />
                                        <ComboBoxItem Content="Snowpeak Ruins" />
                                        <ComboBoxItem Content="Temple of Time" />
                                        <ComboBoxItem Content="City in the Sky" />
                                        <ComboBoxItem Content="Palace of Twilight" />
                                        <ComboBoxItem Content="Hyrule Castle" />
                                        <ComboBoxItem Content="Custom" />
                                    </ComboBox>
                                    <TextBlock Grid.Column="2"
                                               Text="Custom"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                    <TextBox Grid.Column="3"
                                             x:Name="QuestItemsCustomCaptureTypeText"
                                             Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="4"
                                               Text="Stored in persistent capture metadata for progression-chain analysis."
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="94" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="62" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Start offset"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                    <TextBox Grid.Column="1"
                                             x:Name="QuestItemsResearchStartOffsetText"
                                             Text="0x200"
                                             FontFamily="Consolas"
                                             Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="2"
                                               Text="Length"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                    <TextBox Grid.Column="3"
                                             x:Name="QuestItemsResearchLengthText"
                                             Text="0x400"
                                             FontFamily="Consolas"
                                             Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="4"
                                               Text="Recommended broad scan: _playerbase+0x200 length 0x400."
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <WrapPanel Margin="0,0,0,8">
                                    <Button Content="0x200-0x2FF"
                                            Tag="0x200|0x100"
                                            Click="QuestItemsRangePreset_Click" />
                                    <Button Content="0x200-0x3FF"
                                            Tag="0x200|0x200"
                                            Click="QuestItemsRangePreset_Click" />
                                    <Button Content="0x000-0x3FF"
                                            Tag="0x000|0x400"
                                            Click="QuestItemsRangePreset_Click" />
                                    <Button Content="0x000-0x7FF"
                                            Tag="0x000|0x800"
                                            Click="QuestItemsRangePreset_Click" />
                                </WrapPanel>

                                <WrapPanel Margin="0,0,0,8">
                                    <Button Content="Capture Before"
                                            Click="QuestItemsCaptureBefore_Click" />
                                    <Button Content="Capture After"
                                            Click="QuestItemsCaptureAfter_Click" />
                                    <Button Content="Compare"
                                            Click="QuestItemsCompare_Click" />
                                    <Button Content="Export JSON"
                                            Click="QuestItemsExportJson_Click" />
                                    <Button Content="Export CSV"
                                            Click="QuestItemsExportCsv_Click" />
                                </WrapPanel>

                                <WrapPanel Margin="0,0,0,8">
                                    <Button Content="Save Current Capture"
                                            Click="QuestItemsSaveCurrentCapture_Click" />
                                    <Button Content="Save Before Capture"
                                            Click="QuestItemsSaveBeforeCapture_Click" />
                                    <Button Content="Save After Capture"
                                            Click="QuestItemsSaveAfterCapture_Click" />
                                    <Button Content="Load Capture A"
                                            Click="QuestItemsLoadCaptureA_Click" />
                                    <Button Content="Load Capture B"
                                            Click="QuestItemsLoadCaptureB_Click" />
                                    <Button Content="Compare Loaded Captures"
                                            Click="QuestItemsCompareLoadedCaptures_Click" />
                                    <Button Content="Export Report"
                                            Click="QuestItemsExportReport_Click" />
                                    <Button Content="Open Quest Search Folder"
                                            Click="QuestItemsOpenSearchFolder_Click" />
                                </WrapPanel>

                                <WrapPanel Margin="0,0,0,8">
                                    <Button Content="Analyze Loaded Captures"
                                            Click="QuestItemsAnalyzeLoadedCaptures_Click" />
                                    <Button Content="Export Candidate Ranking"
                                            Click="QuestItemsExportCandidateRanking_Click" />
                                    <Button Content="Export Candidate Groups"
                                            Click="QuestItemsExportCandidateGroups_Click" />
                                    <Button Content="Load Multi-Captures"
                                            Click="QuestItemsLoadMultiCaptures_Click" />
                                    <Button Content="Load All Quest Captures"
                                            Click="QuestItemsLoadAllCaptures_Click" />
                                    <Button Content="Analyze Multi-Captures"
                                            Click="QuestItemsAnalyzeMultiCaptures_Click" />
                                    <Button Content="Export Multi-Capture Analysis"
                                            Click="QuestItemsExportMultiCaptureAnalysis_Click" />
                                </WrapPanel>

                                <TextBox x:Name="QuestItemsCaptureAText"
                                         Text="Capture A: not loaded"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         Background="{DynamicResource ReadOnlyBackgroundBrush}"
                                         Margin="0,0,0,4" />
                                <TextBox x:Name="QuestItemsCaptureBText"
                                         Text="Capture B: not loaded"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         Background="{DynamicResource ReadOnlyBackgroundBrush}"
                                         Margin="0,0,0,8" />

                                <TextBox x:Name="QuestItemsResearchStatusText"
                                         Text="Ready. Capture Before and After snapshots, then compare."
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         Background="{DynamicResource ReadOnlyBackgroundBrush}"
                                         Margin="0,0,0,8" />

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="74" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="118" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="76" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Offset" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Before" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="After" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Before bin" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="4" Text="After bin" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="5" Text="Changed bits" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="6" Text="Score" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="7" Text="Group" FontWeight="SemiBold" Margin="6,0" />
                                </Grid>

                                <ScrollViewer Height="300"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto"
                                              Background="{DynamicResource ReadOnlyBackgroundBrush}">
                                    <ItemsControl ItemsSource="{Binding QuestItemsResearchRows}"
                                                  ItemTemplate="{StaticResource QuestItemsResearchRowTemplate}" />
                                </ScrollViewer>

                                <Expander Header="Candidate Ranking" IsExpanded="True" Margin="0,8,0,0">
                                    <StackPanel>
                                        <WrapPanel Margin="0,0,0,8">
                                            <CheckBox x:Name="QuestItemsFilterChangedOnlyCheckBox"
                                                      Content="Changed rows only"
                                                      IsChecked="True"
                                                      Checked="QuestItemsCandidateFilter_Changed"
                                                      Unchecked="QuestItemsCandidateFilter_Changed" />
                                            <CheckBox x:Name="QuestItemsFilterSingleBitOnlyCheckBox"
                                                      Content="Single-bit only"
                                                      Checked="QuestItemsCandidateFilter_Changed"
                                                      Unchecked="QuestItemsCandidateFilter_Changed" />
                                            <CheckBox x:Name="QuestItemsFilterGroupedOnlyCheckBox"
                                                      Content="Grouped only"
                                                      Checked="QuestItemsCandidateFilter_Changed"
                                                      Unchecked="QuestItemsCandidateFilter_Changed" />
                                            <CheckBox x:Name="QuestItemsFilterPersistedOnlyCheckBox"
                                                      Content="Persisted only"
                                                      Checked="QuestItemsCandidateFilter_Changed"
                                                      Unchecked="QuestItemsCandidateFilter_Changed" />
                                            <TextBlock Text="Min score"
                                                       VerticalAlignment="Center"
                                                       Margin="12,0,6,0" />
                                            <TextBox x:Name="QuestItemsFilterMinimumScoreText"
                                                     Text="0"
                                                     Width="46"
                                                     TextChanged="QuestItemsCandidateFilter_Changed" />
                                        </WrapPanel>

                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="74" />
                                                <ColumnDefinition Width="74" />
                                                <ColumnDefinition Width="74" />
                                                <ColumnDefinition Width="112" />
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="84" />
                                                <ColumnDefinition Width="76" />
                                                <ColumnDefinition Width="*" MinWidth="300" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Offset" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="A" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="2" Text="B" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="3" Text="Bits" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="4" Text="Score" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="5" Text="Confidence" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="6" Text="Group" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="7" Text="Reasons" FontWeight="SemiBold" />
                                        </Grid>

                                        <ScrollViewer Height="220"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Auto"
                                                      Background="{DynamicResource ReadOnlyBackgroundBrush}">
                                            <ItemsControl ItemsSource="{Binding QuestItemsCandidateRows}"
                                                          ItemTemplate="{StaticResource QuestItemsCandidateRowTemplate}" />
                                        </ScrollViewer>
                                    </StackPanel>
                                </Expander>

                                <Expander Header="Candidate Groups" IsExpanded="True" Margin="0,8,0,0">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="82" />
                                                <ColumnDefinition Width="126" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="88" />
                                                <ColumnDefinition Width="*" MinWidth="300" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Group" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="Offset Range" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="2" Text="Count" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="3" Text="High Score" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="4" Text="Reasons" FontWeight="SemiBold" />
                                        </Grid>
                                        <ScrollViewer Height="150"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Auto"
                                                      Background="{DynamicResource ReadOnlyBackgroundBrush}">
                                            <ItemsControl ItemsSource="{Binding QuestItemsCandidateGroups}"
                                                          ItemTemplate="{StaticResource QuestItemsCandidateGroupTemplate}" />
                                        </ScrollViewer>
                                    </StackPanel>
                                </Expander>

                                <Expander Header="Multi-Capture Analysis" IsExpanded="False" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Load multiple saved captures from logs/research/quest-search, then analyze the progression chain for bits that only increase, values that step upward, and flags that appear once and remain set."
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Margin="0,0,0,8" />
                                        <Button Content="Analyze Multi-Captures"
                                                HorizontalAlignment="Left"
                                                Click="QuestItemsAnalyzeMultiCaptures_Click" />
                                        <Grid Margin="0,8,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="74" />
                                                <ColumnDefinition Width="*" MinWidth="260" />
                                                <ColumnDefinition Width="88" />
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="84" />
                                                <ColumnDefinition Width="*" MinWidth="260" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Offset" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="Value Progression" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="2" Text="Appearances" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="3" Text="Score" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="4" Text="Confidence" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="5" Text="Reasons" FontWeight="SemiBold" />
                                        </Grid>
                                        <ScrollViewer Height="220"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Auto"
                                                      Background="{DynamicResource ReadOnlyBackgroundBrush}">
                                            <ItemsControl ItemsSource="{Binding QuestItemsMultiCaptureRows}"
                                                          ItemTemplate="{StaticResource QuestItemsMultiCaptureRowTemplate}" />
                                        </ScrollViewer>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="ResearchTopTab"
                     Header="Research"
                     Visibility="{Binding DeveloperToolsVisibility}">
                <Grid Margin="6">
                    <TabControl x:Name="ResearchWorkspaceTabs">
                        <TabItem x:Name="LiveCaptureResearchTab"
                                 Header="Live Capture">
                            <Grid Margin="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <GroupBox Header="Capture Controls">
                                    <StackPanel>
                                        <TextBlock Text="Read-only continuous memory monitoring. Live Capture never writes memory."
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,6" />
                                        <WrapPanel>
                                            <TextBlock Text="Label" VerticalAlignment="Center" Margin="0,0,6,4" />
                                            <TextBox x:Name="LiveCaptureLabelText"
                                                     Width="170"
                                                     Margin="0,0,12,4" />
                                            <TextBlock Text="Start Offset" VerticalAlignment="Center" Margin="0,0,6,4" />
                                            <TextBox x:Name="LiveCaptureStartOffsetText"
                                                     Text="0x0000"
                                                     FontFamily="Consolas"
                                                     Width="92"
                                                     Margin="0,0,12,4" />
                                            <TextBlock Text="Length" VerticalAlignment="Center" Margin="0,0,6,4" />
                                            <TextBox x:Name="LiveCaptureLengthText"
                                                     Text="0x400"
                                                     FontFamily="Consolas"
                                                     Width="82"
                                                     Margin="0,0,12,4" />
                                            <TextBlock Text="Sampling ms" VerticalAlignment="Center" Margin="0,0,6,4" />
                                            <TextBox x:Name="LiveCaptureSamplingRateText"
                                                     Text="250"
                                                     FontFamily="Consolas"
                                                     Width="72"
                                                     Margin="0,0,12,4" />
                                            <Button Content="Start Capture"
                                                    Click="LiveCaptureStart_Click"
                                                    Margin="0,0,4,4" />
                                            <Button Content="Stop Capture"
                                                    Click="LiveCaptureStop_Click"
                                                    Margin="0,0,4,4" />
                                            <Button Content="Check Persistence"
                                                    Click="LiveCaptureCheckPersistence_Click"
                                                    Margin="0,0,4,4" />
                                            <Button Content="Clear Session"
                                                    Click="LiveCaptureClear_Click"
                                                    Margin="0,0,4,4" />
                                            <Button Content="Export Session"
                                                    Click="LiveCaptureExport_Click"
                                                    Margin="0,0,4,4" />
                                        </WrapPanel>

                                        <WrapPanel Margin="0,4,0,0">
                                            <CheckBox x:Name="LiveCaptureHideFrequentCheckBox"
                                                      Content="Hide Frequently Changing"
                                                      IsChecked="True"
                                                      Checked="LiveCaptureFilter_Changed"
                                                      Unchecked="LiveCaptureFilter_Changed"
                                                      Margin="0,0,12,4" />
                                            <CheckBox x:Name="LiveCaptureSingleBitOnlyCheckBox"
                                                      Content="Show Single-Bit Only"
                                                      Checked="LiveCaptureFilter_Changed"
                                                      Unchecked="LiveCaptureFilter_Changed"
                                                      Margin="0,0,12,4" />
                                            <CheckBox x:Name="LiveCapturePersistedOnlyCheckBox"
                                                      Content="Show Persisted Only"
                                                      Checked="LiveCaptureFilter_Changed"
                                                      Unchecked="LiveCaptureFilter_Changed"
                                                      Margin="0,0,12,4" />
                                            <CheckBox x:Name="LiveCaptureChangedOnceCheckBox"
                                                      Content="Show Changed Once"
                                                      Checked="LiveCaptureFilter_Changed"
                                                      Unchecked="LiveCaptureFilter_Changed"
                                                      Margin="0,0,12,4" />
                                            <CheckBox x:Name="LiveCaptureHideSceneNoiseCheckBox"
                                                      Content="Hide Known Scene Noise"
                                                      IsChecked="True"
                                                      Checked="LiveCaptureFilter_Changed"
                                                      Unchecked="LiveCaptureFilter_Changed"
                                                      Margin="0,0,12,4" />
                                            <TextBlock Text="Score >="
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,4" />
                                            <TextBox x:Name="LiveCaptureScoreThresholdText"
                                                     Text="0"
                                                     Width="52"
                                                     FontFamily="Consolas"
                                                     TextChanged="LiveCaptureFilter_Changed"
                                                     Margin="0,0,12,4" />
                                        </WrapPanel>
                                    </StackPanel>
                                </GroupBox>

                                <Grid Grid.Row="1" Margin="0,8,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <GroupBox Header="Active Changes" Grid.RowSpan="2" Margin="0,0,6,0">
                                        <DataGrid ItemsSource="{Binding LiveCaptureChanges}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  Height="360"
                                                  SelectionMode="Single"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Offset" Binding="{Binding Offset}" Width="80" />
                                                <DataGridTextColumn Header="Old Value" Binding="{Binding OldValue}" Width="80" />
                                                <DataGridTextColumn Header="Current Value" Binding="{Binding CurrentByte}" Width="95" />
                                                <DataGridTextColumn Header="Change Count" Binding="{Binding ChangeCount}" Width="90" />
                                                <DataGridTextColumn Header="First Seen" Binding="{Binding FirstSeenText}" Width="100" />
                                                <DataGridTextColumn Header="Last Seen" Binding="{Binding LastSeenText}" Width="100" />
                                                <DataGridTextColumn Header="Bit Change Summary" Binding="{Binding BitChangeSummary}" Width="150" />
                                                <DataGridTextColumn Header="Persisted Status" Binding="{Binding PersistedStatus}" Width="120" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </GroupBox>

                                    <GroupBox Grid.Column="1" Header="Candidate Ranking" Margin="6,0,0,4">
                                        <DataGrid ItemsSource="{Binding LiveCaptureCandidates}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  Height="170"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Offset" Binding="{Binding Offset}" Width="70" />
                                                <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="55" />
                                                <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="80" />
                                                <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="220" />
                                                <DataGridTextColumn Header="Current" Binding="{Binding CurrentValue}" Width="70" />
                                                <DataGridTextColumn Header="Changes" Binding="{Binding ChangeCount}" Width="65" />
                                                <DataGridTextColumn Header="Persisted" Binding="{Binding PersistedStatus}" Width="90" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </GroupBox>

                                    <GroupBox Grid.Row="1" Grid.Column="1" Header="Timeline / Statistics" Margin="6,4,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ScrollViewer Height="160"
                                                          VerticalScrollBarVisibility="Auto"
                                                          Background="{DynamicResource ReadOnlyBackgroundBrush}"
                                                          Margin="0,0,4,0">
                                                <ItemsControl ItemsSource="{Binding LiveCaptureTimelineLines}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}"
                                                                       FontFamily="Consolas"
                                                                       FontSize="11"
                                                                       TextWrapping="NoWrap" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                            <ScrollViewer Grid.Column="1"
                                                          Height="160"
                                                          VerticalScrollBarVisibility="Auto"
                                                          Background="{DynamicResource ReadOnlyBackgroundBrush}"
                                                          Margin="4,0,0,0">
                                                <ItemsControl ItemsSource="{Binding LiveCaptureStatisticsLines}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}"
                                                                       TextWrapping="Wrap"
                                                                       Margin="0,0,0,3" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </GroupBox>
                                </Grid>

                                <TextBlock Grid.Row="2"
                                           x:Name="LiveCaptureStatusText"
                                           Text="Ready. Attach to Cemu and rescan before starting Live Capture."
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="SnapshotDiffResearchTab"
                                 Header="Snapshot Diff">
                            <Grid Margin="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <GroupBox Header="Capture Controls">
                                    <StackPanel>
                                        <TextBlock Text="Compact range snapshot comparison. This is read-only and exports reports to logs/research/."
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,6" />
                                        <WrapPanel>
                                            <TextBlock Text="Label" VerticalAlignment="Center" Margin="0,0,6,4" />
                                            <TextBox x:Name="ResearchWorkspaceSnapshotLabelText"
                                                     Width="180"
                                                     Margin="0,0,12,4" />
                                            <TextBlock Text="Start Offset" VerticalAlignment="Center" Margin="0,0,6,4" />
                                            <TextBox x:Name="ResearchWorkspaceSnapshotStartOffsetText"
                                                     Text="0x200"
                                                     FontFamily="Consolas"
                                                     Width="90"
                                                     Margin="0,0,12,4" />
                                            <TextBlock Text="Length" VerticalAlignment="Center" Margin="0,0,6,4" />
                                            <TextBox x:Name="ResearchWorkspaceSnapshotLengthText"
                                                     Text="0x400"
                                                     FontFamily="Consolas"
                                                     Width="90"
                                                     Margin="0,0,12,4" />
                                            <Button Content="Capture A"
                                                    Click="ResearchWorkspaceCaptureA_Click"
                                                    Margin="0,0,4,4" />
                                            <Button Content="Capture B"
                                                    Click="ResearchWorkspaceCaptureB_Click"
                                                    Margin="0,0,4,4" />
                                            <Button Content="Compare"
                                                    Click="ResearchWorkspaceCompareSnapshots_Click"
                                                    Margin="0,0,4,4" />
                                            <Button Content="Export JSON"
                                                    Click="ResearchWorkspaceExportJson_Click"
                                                    Margin="0,0,4,4" />
                                            <Button Content="Export CSV"
                                                    Click="ResearchWorkspaceExportCsv_Click"
                                                    Margin="0,0,4,4" />
                                        </WrapPanel>
                                    </StackPanel>
                                </GroupBox>

                                <Grid Grid.Row="1" Margin="0,8,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <GroupBox Header="Candidate Ranking" Margin="0,0,6,0">
                                        <DataGrid ItemsSource="{Binding ResearchWorkspaceSnapshotCandidates}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  Height="360"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Offset" Binding="{Binding Offset}" Width="80" />
                                                <DataGridTextColumn Header="Score" Binding="{Binding CandidateScore}" Width="65" />
                                                <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="80" />
                                                <DataGridTextColumn Header="Changed Bits" Binding="{Binding ChangedBits}" Width="130" />
                                                <DataGridTextColumn Header="Group" Binding="{Binding GroupName}" Width="90" />
                                                <DataGridTextColumn Header="Reasons" Binding="{Binding Reasons}" Width="260" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </GroupBox>
                                    <GroupBox Grid.Column="1" Header="Changed Bytes" Margin="6,0,0,0">
                                        <DataGrid ItemsSource="{Binding ResearchWorkspaceSnapshotRows}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  Height="360"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Offset" Binding="{Binding Offset}" Width="80" />
                                                <DataGridTextColumn Header="Before" Binding="{Binding BeforeByte}" Width="95" />
                                                <DataGridTextColumn Header="After" Binding="{Binding AfterByte}" Width="95" />
                                                <DataGridTextColumn Header="Before Binary" Binding="{Binding BeforeBinary}" Width="100" />
                                                <DataGridTextColumn Header="After Binary" Binding="{Binding AfterBinary}" Width="100" />
                                                <DataGridTextColumn Header="Changed Bits" Binding="{Binding ChangedBits}" Width="130" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </GroupBox>
                                </Grid>

                                <TextBlock Grid.Row="2"
                                           x:Name="ResearchWorkspaceSnapshotStatusText"
                                           Text="Capture A and B to compare a range."
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="CandidateTesterResearchTab"
                                 Header="Candidate Tester">
                            <Grid Margin="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border BorderBrush="{DynamicResource WarningBorderBrush}"
                                        BorderThickness="1"
                                        Background="{DynamicResource WarningBackgroundBrush}"
                                        Padding="8"
                                        Margin="0,0,0,8">
                                    <TextBlock Text="Advanced / Research. This tool writes one raw byte only when you click Write. Use copied saves and restore the previous value after testing."
                                               Foreground="{DynamicResource WarningTextBrush}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                </Border>

                                <GroupBox Grid.Row="1" Header="Candidate Offset Tester">
                                    <StackPanel>
                                        <WrapPanel Margin="0,0,0,8">
                                            <Button Content="0x288" Tag="0x288" Click="ResearchCandidatePreset_Click" />
                                            <Button Content="0x293" Tag="0x293" Click="ResearchCandidatePreset_Click" />
                                            <Button Content="0x29A" Tag="0x29A" Click="ResearchCandidatePreset_Click" />
                                            <Button Content="0x253" Tag="0x253" Click="ResearchCandidatePreset_Click" />
                                            <Button Content="0x26C" Tag="0x26C" Click="ResearchCandidatePreset_Click" />
                                            <Button Content="0x26D" Tag="0x26D" Click="ResearchCandidatePreset_Click" />
                                            <Button Content="0x26E" Tag="0x26E" Click="ResearchCandidatePreset_Click" />
                                            <Button Content="0x3D5" Tag="0x3D5" Click="ResearchCandidatePreset_Click" />
                                            <Button Content="0x3D6" Tag="0x3D6" Click="ResearchCandidatePreset_Click" />
                                        </WrapPanel>
                                        <WrapPanel>
                                            <TextBlock Text="Offset" VerticalAlignment="Center" Margin="0,0,6,4" />
                                            <TextBox x:Name="ResearchCandidateOffsetText"
                                                     Text="0x288"
                                                     FontFamily="Consolas"
                                                     Width="90"
                                                     Margin="0,0,12,4" />
                                            <TextBlock Text="New Value" VerticalAlignment="Center" Margin="0,0,6,4" />
                                            <TextBox x:Name="ResearchCandidateValueText"
                                                     Text="0x01"
                                                     FontFamily="Consolas"
                                                     Width="80"
                                                     Margin="0,0,12,4" />
                                            <Button Content="Read"
                                                    Click="ResearchCandidateReadCurrent_Click"
                                                    Margin="0,0,4,4" />
                                            <Button Content="Write"
                                                    Click="ResearchCandidateWriteValue_Click"
                                                    Margin="0,0,4,4" />
                                            <Button Content="Restore"
                                                    Click="ResearchCandidateRestorePrevious_Click"
                                                    Margin="0,0,4,4" />
                                        </WrapPanel>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Absolute" Margin="0,0,6,5" />
                                            <TextBox Grid.Column="1"
                                                     x:Name="ResearchCandidateAbsoluteAddressText"
                                                     Text="-"
                                                     IsReadOnly="True"
                                                     FontFamily="Consolas"
                                                     Background="{DynamicResource ReadOnlyBackgroundBrush}"
                                                     Margin="0,0,12,5" />
                                            <TextBlock Grid.Column="2" Text="Current" Margin="0,0,6,5" />
                                            <TextBox Grid.Column="3"
                                                     x:Name="ResearchCandidateCurrentByteText"
                                                     Text="Not read"
                                                     IsReadOnly="True"
                                                     FontFamily="Consolas"
                                                     Background="{DynamicResource ReadOnlyBackgroundBrush}"
                                                     Margin="0,0,0,5" />
                                            <TextBlock Grid.Row="1" Text="Previous" Margin="0,0,6,0" />
                                            <TextBox Grid.Row="1"
                                                     Grid.Column="1"
                                                     x:Name="ResearchCandidatePreviousByteText"
                                                     Text="Not captured"
                                                     IsReadOnly="True"
                                                     FontFamily="Consolas"
                                                     Background="{DynamicResource ReadOnlyBackgroundBrush}"
                                                     Margin="0,0,12,0" />
                                        </Grid>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Grid.Row="2" Header="Result Log" Margin="0,8,0,0">
                                    <TextBlock x:Name="ResearchCandidateStatusText"
                                               Text="Ready. No automatic writes."
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </GroupBox>
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="AnalysisReportsResearchTab"
                                 Header="Analysis Reports">
                            <Grid Margin="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <WrapPanel Margin="0,0,0,8">
                                    <TextBlock Text="Search/filter" VerticalAlignment="Center" Margin="0,0,6,4" />
                                    <TextBox x:Name="ResearchReportFilterText"
                                             Width="240"
                                             TextChanged="ResearchReportFilter_Changed"
                                             Margin="0,0,12,4" />
                                    <Button Content="Refresh"
                                            Click="RefreshResearchReports_Click"
                                            Margin="0,0,4,4" />
                                    <Button Content="Open Folder"
                                            Click="OpenResearchReportsFolder_Click"
                                            Margin="0,0,4,4" />
                                </WrapPanel>

                                <DataGrid Grid.Row="1"
                                          ItemsSource="{Binding ResearchReports}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          Height="430"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="260" />
                                        <DataGridTextColumn Header="Type" Binding="{Binding ReportType}" Width="110" />
                                        <DataGridTextColumn Header="Created" Binding="{Binding CreatedText}" Width="140" />
                                        <DataGridTextColumn Header="Capture A" Binding="{Binding CaptureA}" Width="150" />
                                        <DataGridTextColumn Header="Capture B" Binding="{Binding CaptureB}" Width="150" />
                                        <DataGridTextColumn Header="Changed Bytes" Binding="{Binding ChangedBytes}" Width="110" />
                                        <DataGridTemplateColumn Header="Open" Width="70">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Open"
                                                            Tag="{Binding}"
                                                            Click="OpenResearchReport_Click" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Export" Width="80">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Export"
                                                            Tag="{Binding}"
                                                            Click="ExportResearchReport_Click" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Grid.Row="2"
                                           x:Name="ResearchReportsStatusText"
                                           Text="Reports are loaded from logs/research/."
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0" />
                            </Grid>
                        </TabItem>

                        <TabItem Header="Logs">
                            <Grid Margin="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <WrapPanel Margin="0,0,0,8">
                                    <CheckBox x:Name="ResearchLogAutoScrollCheckBox"
                                              Content="Auto-scroll"
                                              IsChecked="True"
                                              Margin="0,0,12,4" />
                                    <TextBlock Text="Category" VerticalAlignment="Center" Margin="0,0,6,4" />
                                    <ComboBox x:Name="ResearchLogCategoryComboBox"
                                              Width="150"
                                              SelectionChanged="ResearchLogCategory_SelectionChanged"
                                              SelectedIndex="0"
                                              Margin="0,0,12,4">
                                        <ComboBoxItem Content="All" />
                                        <ComboBoxItem Content="Live Capture" />
                                        <ComboBoxItem Content="Quest" />
                                        <ComboBoxItem Content="Hidden Skills" />
                                        <ComboBoxItem Content="Candidate" />
                                        <ComboBoxItem Content="Scan" />
                                        <ComboBoxItem Content="Inventory" />
                                        <ComboBoxItem Content="Equipment" />
                                        <ComboBoxItem Content="Collectibles" />
                                        <ComboBoxItem Content="Bottles" />
                                        <ComboBoxItem Content="Bomb Slots" />
                                        <ComboBoxItem Content="Research" />
                                    </ComboBox>
                                    <Button Content="Refresh"
                                            Click="RefreshResearchLogs_Click"
                                            Margin="0,0,4,4" />
                                    <Button Content="Clear Display"
                                            Click="ClearResearchLogs_Click"
                                            Margin="0,0,4,4" />
                                    <Button Content="Open Logs Folder"
                                            Click="OpenResearchLogsFolder_Click"
                                            Margin="0,0,4,4" />
                                </WrapPanel>

                                <ScrollViewer Grid.Row="1"
                                              x:Name="ResearchLogsScrollViewer"
                                              Height="440"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto"
                                              Background="{DynamicResource ReadOnlyBackgroundBrush}">
                                    <ItemsControl ItemsSource="{Binding ResearchLogViewerLines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           TextWrapping="NoWrap"
                                                           Margin="0,0,0,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBlock Grid.Row="2"
                                           x:Name="ResearchLogStatusText"
                                           Text="Log viewer is display-only. Clear Display does not delete log files."
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0" />
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>

            <TabItem x:Name="DebugTopTab"
                     Header="Debug"
                     Visibility="{Binding DeveloperToolsVisibility}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <UniformGrid Columns="2" Margin="6">
                        <GroupBox Header="Current Player Base">
                            <StackPanel>
                                <TextBox x:Name="DebugPlayerBaseText"
                                         Text="-"
                                         IsReadOnly="True"
                                         FontFamily="Consolas"
                                         Background="{DynamicResource ReadOnlyBackgroundBrush}" />
                                <TextBlock Text="AOB pattern"
                                           Margin="0,10,0,2" />
                                <TextBox x:Name="AobPatternText"
                                         IsReadOnly="True"
                                         FontFamily="Consolas"
                                         TextWrapping="Wrap"
                                         Background="{DynamicResource ReadOnlyBackgroundBrush}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="AOB Scan Diagnostics">
                            <StackPanel>
                                <TextBlock Text="Also written to logs/scan.log after Attach / Rescan"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,0,6" />
                                <TextBox x:Name="ScanDiagnosticsText"
                                         Text="No scan has run yet."
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         MinHeight="150"
                                         FontFamily="Consolas"
                                         Background="{DynamicResource ReadOnlyBackgroundBrush}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Support Snapshot">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,0,8"
                                           Text="Creates a timestamped troubleshooting package with sanitized trainer state and relative log files. Save files are not included." />
                                <Button Content="Create Support Snapshot"
                                        HorizontalAlignment="Left"
                                        Click="CreateSupportSnapshot_Click"
                                        Margin="0,0,0,8" />
                                <TextBox x:Name="SupportSnapshotStatusText"
                                         Text="Ready. Support snapshots are written to support-snapshots/."
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         Background="{DynamicResource ReadOnlyBackgroundBrush}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Progression Diagnostics">
                            <StackPanel>
                                <TextBlock Text="Also written to logs/progression.log after Attach / Rescan"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Player base" VerticalAlignment="Center" Margin="0,0,8,5" />
                                    <TextBox Grid.Column="1"
                                             x:Name="ProgressionPlayerBaseText"
                                             Text="-"
                                             IsReadOnly="True"
                                             FontFamily="Consolas"
                                             Background="{DynamicResource ReadOnlyBackgroundBrush}"
                                             Margin="0,0,0,5" />

                                    <TextBlock Grid.Row="1" Text="Player Data" VerticalAlignment="Center" Margin="0,0,8,5" />
                                    <TextBox Grid.Row="1"
                                             Grid.Column="1"
                                             x:Name="ProgressionPlayerDataText"
                                             Text="-"
                                             IsReadOnly="True"
                                             Background="{DynamicResource ReadOnlyBackgroundBrush}"
                                             Margin="0,0,0,5" />

                                    <TextBlock Grid.Row="2" Text="Memory Initialized" VerticalAlignment="Center" Margin="0,0,8,5" />
                                    <TextBox Grid.Row="2"
                                             Grid.Column="1"
                                             x:Name="ProgressionMemoryInitializedText"
                                             Text="-"
                                             IsReadOnly="True"
                                             Background="{DynamicResource ReadOnlyBackgroundBrush}"
                                             Margin="0,0,0,5" />

                                    <TextBlock Grid.Row="3" Text="Ownership Edits Accepted" VerticalAlignment="Center" Margin="0,0,8,5" />
                                    <TextBox Grid.Row="3"
                                             Grid.Column="1"
                                             x:Name="ProgressionOwnershipAcceptanceText"
                                             Text="Unknown"
                                             IsReadOnly="True"
                                             Background="{DynamicResource ReadOnlyBackgroundBrush}"
                                             Margin="0,0,0,5" />

                                    <TextBlock Grid.Row="4" Text="Detection Reason" VerticalAlignment="Center" Margin="0,0,8,5" />
                                    <TextBox Grid.Row="4"
                                             Grid.Column="1"
                                             x:Name="ProgressionOwnershipReasonText"
                                             Text="Player data is not available."
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             Background="{DynamicResource ReadOnlyBackgroundBrush}"
                                             Margin="0,0,0,5" />

                                    <TextBlock Grid.Row="5" Text="Inventory" VerticalAlignment="Center" Margin="0,0,8,5" />
                                    <TextBox Grid.Row="5"
                                             Grid.Column="1"
                                             x:Name="ProgressionInventoryInitializedText"
                                             Text="-"
                                             IsReadOnly="True"
                                             Background="{DynamicResource ReadOnlyBackgroundBrush}"
                                             Margin="0,0,0,5" />

                                    <TextBlock Grid.Row="6" Text="Equipment" VerticalAlignment="Center" Margin="0,0,8,5" />
                                    <TextBox Grid.Row="6"
                                             Grid.Column="1"
                                             x:Name="ProgressionEquipmentInitializedText"
                                             Text="-"
                                             IsReadOnly="True"
                                             Background="{DynamicResource ReadOnlyBackgroundBrush}"
                                             Margin="0,0,0,5" />

                                    <TextBlock Grid.Row="7" Text="Inventory raw bytes" VerticalAlignment="Center" Margin="0,0,8,5" />
                                    <TextBox Grid.Row="7"
                                             Grid.Column="1"
                                             x:Name="ProgressionInventoryRawBytesText"
                                             Text="Not read"
                                             IsReadOnly="True"
                                             FontFamily="Consolas"
                                             TextWrapping="Wrap"
                                             Background="{DynamicResource ReadOnlyBackgroundBrush}"
                                             Margin="0,0,0,5" />

                                    <TextBlock Grid.Row="8" Text="Ownership bytes" VerticalAlignment="Center" Margin="0,0,8,5" />
                                    <TextBox Grid.Row="8"
                                             Grid.Column="1"
                                             x:Name="ProgressionEquipmentOwnershipBytesText"
                                             Text="Not read"
                                             IsReadOnly="True"
                                             FontFamily="Consolas"
                                             Background="{DynamicResource ReadOnlyBackgroundBrush}"
                                             Margin="0,0,0,5" />

                                    <TextBlock Grid.Row="9" Text="Equipped bytes" VerticalAlignment="Center" Margin="0,0,8,5" />
                                    <TextBox Grid.Row="9"
                                             Grid.Column="1"
                                             x:Name="ProgressionEquipmentEquippedBytesText"
                                             Text="Not read"
                                             IsReadOnly="True"
                                             FontFamily="Consolas"
                                             Background="{DynamicResource ReadOnlyBackgroundBrush}"
                                             Margin="0,0,0,5" />

                                    <TextBlock Grid.Row="10" Text="Current status" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox Grid.Row="10"
                                             Grid.Column="1"
                                             x:Name="ProgressionStatusMessageText"
                                             Text="Not attached"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             Background="{DynamicResource ReadOnlyBackgroundBrush}" />
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Hidden Skills Editor Diagnostics">
                            <StackPanel>
                                <TextBlock Text="Also written to logs/hidden-skills-editor.log"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,0,6" />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="0x3D5"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,5" />
                                    <TextBox Grid.Column="1"
                                             x:Name="HiddenSkillsDebugByte3D5Text"
                                             Text="Not read"
                                             IsReadOnly="True"
                                             FontFamily="Consolas"
                                             Background="{DynamicResource ReadOnlyBackgroundBrush}"
                                             Margin="0,0,8,5" />
                                    <TextBlock Grid.Column="2"
                                               Text="0x3D6"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,5" />
                                    <TextBox Grid.Column="3"
                                             x:Name="HiddenSkillsDebugByte3D6Text"
                                             Text="Not read"
                                             IsReadOnly="True"
                                             FontFamily="Consolas"
                                             Background="{DynamicResource ReadOnlyBackgroundBrush}"
                                             Margin="0,0,0,5" />
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="140" />
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" MinWidth="170" />
                                        <ColumnDefinition Width="*" MinWidth="190" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Skill" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Offset" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="Bit" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Current" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="4" Text="Last write" FontWeight="SemiBold" Margin="6,0" />
                                    <TextBlock Grid.Column="5" Text="Last verification" FontWeight="SemiBold" Margin="6,0" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding HiddenSkillsEditorRows}"
                                              ItemTemplate="{StaticResource HiddenSkillDiagnosticTemplate}" />

                                <ScrollViewer Height="150"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto"
                                              Background="{DynamicResource ReadOnlyBackgroundBrush}"
                                              Margin="0,8,0,0">
                                    <ItemsControl ItemsSource="{Binding HiddenSkillsEditorDiagnostics}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           TextWrapping="NoWrap"
                                                           Margin="0,0,0,4" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
