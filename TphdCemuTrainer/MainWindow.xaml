                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" MinWidth="160" />
                                        <ColumnDefinition Width="*" MinWidth="180" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Skill" FontWeight="SemiBold" />
