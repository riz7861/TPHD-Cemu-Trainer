                                             Background="#F7F7F7"
                                             Margin="0,0,0,5" />

                                    <TextBlock Grid.Row="5" Text="Equipped bytes" VerticalAlignment="Center" Margin="0,0,8,5" />
                                    <TextBox Grid.Row="5"
                                             Grid.Column="1"
                                             x:Name="ProgressionEquipmentEquippedBytesText"
                                             Text="Not read"
                                             IsReadOnly="True"
                                             FontFamily="Consolas"
                                             Background="#F7F7F7"
                                             Margin="0,0,0,5" />

                                    <TextBlock Grid.Row="6" Text="Current status" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox Grid.Row="6"
                                             Grid.Column="1"
                                             x:Name="ProgressionStatusMessageText"
                                             Text="Not attached"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             Background="#F7F7F7" />
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Research">
