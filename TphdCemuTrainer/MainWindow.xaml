                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </GroupBox>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Golden Bugs Bitfield Tester / Experimental">
