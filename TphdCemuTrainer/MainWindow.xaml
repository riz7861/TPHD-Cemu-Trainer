                                              Margin="0,0,12,0" />
                                    <CheckBox x:Name="ResearchSaveEquipmentRangeCheckBox"
                                              Content="Equipment"
                                              IsChecked="True"
                                              Margin="0,0,12,0" />
                                    <CheckBox x:Name="ResearchSaveOwnershipRangeCheckBox"
                                              Content="Ownership"
                                              IsChecked="True"
                                              Margin="0,0,12,0" />
                                    <CheckBox x:Name="ResearchSaveCustomRangeCheckBox"
                                              Content="Custom range"
                                              ToolTip="Uses the start offset, length, and label from Research Range Snapshot."
                                              Margin="0,0,12,0" />
                                    <Button Content="Save Snapshot"
                                            Click="ResearchSaveSnapshot_Click" />
                                    <Button Content="Refresh Library"
                                            Click="ResearchRefreshSnapshots_Click" />
                                </StackPanel>

                                <TextBox x:Name="ResearchSnapshotLibraryStatusText"
                                         Text="Snapshot library ready"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         Background="{DynamicResource ReadOnlyBackgroundBrush}"
                                         Margin="0,0,0,8" />

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="130" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" MinWidth="130" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Snapshot Name" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Date" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="Notes" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Ranges" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                </Grid>

                                <ListBox x:Name="ResearchSnapshotListBox"
                                         ItemsSource="{Binding ResearchSnapshots}"
                                         ItemTemplate="{StaticResource ResearchSnapshotTemplate}"
                                         Height="170"
                                         Background="{DynamicResource ReadOnlyBackgroundBrush}" />

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                                    <Button Content="Load As A"
                                            Click="ResearchLoadSnapshotA_Click" />
                                    <Button Content="Load As B"
                                            Click="ResearchLoadSnapshotB_Click" />
                                    <Button Content="Delete"
                                            Click="ResearchDeleteSnapshot_Click" />
                                    <Button Content="Compare A/B"
                                            Click="ResearchCompareSavedSnapshots_Click" />
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Snapshot A" VerticalAlignment="Center" Margin="0,0,6,5" />
                                    <TextBox Grid.Column="1"
                                             x:Name="ResearchSnapshotAText"
                                             Text="-"
                                             IsReadOnly="True"
                                             Background="{DynamicResource ReadOnlyBackgroundBrush}"
                                             Margin="0,0,0,5" />
                                    <TextBlock Grid.Row="1" Text="Snapshot B" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Grid.Row="1"
                                             Grid.Column="1"
                                             x:Name="ResearchSnapshotBText"
                                             Text="-"
                                             IsReadOnly="True"
                                             Background="{DynamicResource ReadOnlyBackgroundBrush}" />
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Snapshot Compare">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,0,8"
                                           Text="Compares two saved snapshots without requiring the game to be running. Changed rows are highlighted and exports are written to logs/research as JSON and CSV." />

                                <TextBox x:Name="ResearchSnapshotCompareStatusText"
                                         Text="Load Snapshot A and Snapshot B"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         Background="{DynamicResource ReadOnlyBackgroundBrush}"
                                         Margin="0,0,0,8" />

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="74" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" MinWidth="110" />
                                        <ColumnDefinition Width="*" MinWidth="110" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Offset" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Snapshot A" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="Snapshot B" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Diff" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="4" Text="A Decode" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="5" Text="B Decode" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="6" Text="Changed" FontWeight="SemiBold" />
                                </Grid>

                                <ScrollViewer Height="220"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto"
                                              Background="{DynamicResource ReadOnlyBackgroundBrush}"
                                              Margin="0,0,0,8">
                                    <ItemsControl ItemsSource="{Binding ResearchSnapshotCompareRows}"
                                                  ItemTemplate="{StaticResource ResearchSnapshotCompareRowTemplate}" />
                                </ScrollViewer>

                                <TextBlock Text="Discovery Report"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,4" />
                                <ScrollViewer Height="110"
                                              VerticalScrollBarVisibility="Auto"
                                              Background="{DynamicResource ReadOnlyBackgroundBrush}">
                                    <ItemsControl ItemsSource="{Binding ResearchDiscoveryReportLines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           TextWrapping="Wrap"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           Margin="0,0,0,4" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Raw Memory Values">
                            <ItemsControl ItemsSource="{Binding RawMemoryValues}"
                                          ItemTemplate="{StaticResource ReadOnlyRawValueTemplate}" />
                        </GroupBox>

                        <GroupBox Header="Inventory Diagnostics">
                            <StackPanel>
                                <TextBlock Text="Also written to logs/inventory.log"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,0,6" />
                                <ScrollViewer Height="190"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto"
                                              Background="{DynamicResource ReadOnlyBackgroundBrush}">
                                    <ItemsControl ItemsSource="{Binding InventoryDiagnostics}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           TextWrapping="NoWrap"
                                                           Margin="0,0,0,4" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Inventory Ownership Diagnostics">
                            <StackPanel>
                                <TextBlock Text="Also written to logs/inventory-ownership.log"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,0,6" />
                                <ScrollViewer Height="190"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto"
                                              Background="{DynamicResource ReadOnlyBackgroundBrush}">
                                    <ItemsControl ItemsSource="{Binding InventoryOwnershipDiagnostics}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           TextWrapping="NoWrap"
                                                           Margin="0,0,0,4" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Inventory Removal Diagnostics">
                            <StackPanel>
                                <TextBlock Text="Also written to logs/inventory-removal.log"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,0,6" />
                                <ScrollViewer Height="190"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto"
                                              Background="{DynamicResource ReadOnlyBackgroundBrush}">
                                    <ItemsControl ItemsSource="{Binding InventoryRemovalDiagnostics}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           TextWrapping="NoWrap"
                                                           Margin="0,0,0,4" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Inventory Checkbox Testing Diagnostics">
                            <StackPanel>
                                <TextBlock Text="Also written to logs/inventory-checkbox-testing.log"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,0,6" />
                                <ScrollViewer Height="190"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto"
                                              Background="{DynamicResource ReadOnlyBackgroundBrush}">
                                    <ItemsControl ItemsSource="{Binding InventoryCheckboxTestingDiagnostics}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           TextWrapping="NoWrap"
                                                           Margin="0,0,0,4" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Bottle Editor Diagnostics">
                            <StackPanel>
                                <TextBlock Text="Bottle write diagnostics are also written to logs/bottle-editor.log"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,0,6" />

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="54" />
                                        <ColumnDefinition Width="74" />
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" MinWidth="260" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Slot" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Offset" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="Current" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Previous" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="4" Text="Last write" FontWeight="SemiBold" Margin="6,0" />
                                    <TextBlock Grid.Column="5" Text="Last verification" FontWeight="SemiBold" Margin="6,0" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding BottleSlots}"
                                              ItemTemplate="{StaticResource BottleDiagnosticTemplate}" />

                                <ScrollViewer Height="170"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto"
                                              Background="{DynamicResource ReadOnlyBackgroundBrush}"
                                              Margin="0,8,0,0">
                                    <ItemsControl ItemsSource="{Binding BottleEditorDiagnostics}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           TextWrapping="NoWrap"
                                                           Margin="0,0,0,4" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Bomb Slot Editor Diagnostics">
                            <StackPanel>
                                <TextBlock Text="Bomb Slot write diagnostics are also written to logs/bomb-slot-editor.log"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,0,6" />

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="54" />
                                        <ColumnDefinition Width="74" />
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" MinWidth="220" />
                                        <ColumnDefinition Width="*" MinWidth="250" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Slot" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Offset" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="Current" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Previous" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="4" Text="Hex" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="5" Text="Decimal" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="6" Text="Binary" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="7" Text="Last write" FontWeight="SemiBold" Margin="6,0" />
                                    <TextBlock Grid.Column="8" Text="Last verification" FontWeight="SemiBold" Margin="6,0" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding BombSlots}"
                                              ItemTemplate="{StaticResource BombSlotDiagnosticTemplate}" />

                                <ScrollViewer Height="170"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto"
                                              Background="{DynamicResource ReadOnlyBackgroundBrush}"
                                              Margin="0,8,0,0">
                                    <ItemsControl ItemsSource="{Binding BombSlotEditorDiagnostics}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           TextWrapping="NoWrap"
                                                           Margin="0,0,0,4" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Collectibles Diagnostics">
                            <StackPanel>
                                <TextBlock Text="Also written to logs/collectibles.log"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,0,6" />
                                <ScrollViewer Height="190"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto"
                                              Background="{DynamicResource ReadOnlyBackgroundBrush}">
                                    <ItemsControl ItemsSource="{Binding CollectiblesDiagnostics}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           TextWrapping="NoWrap"
                                                           Margin="0,0,0,4" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Equipment Diagnostics">
                            <StackPanel>
                                <TextBlock Text="Also written to logs/equipment.log"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,0,6" />
                                <ScrollViewer Height="190"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto"
                                              Background="{DynamicResource ReadOnlyBackgroundBrush}">
                                    <ItemsControl ItemsSource="{Binding EquipmentDiagnostics}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           TextWrapping="NoWrap"
                                                           Margin="0,0,0,4" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Advanced Tools">
                            <ItemsControl ItemsSource="{Binding DebugTools}"
                                          ItemTemplate="{StaticResource FutureTextTemplate}" />
                        </GroupBox>

                        <GroupBox Header="Coordinate Display">
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="Coordinate display and teleport tools are reserved for a future coordinate-base scan implementation." />
                        </GroupBox>
                    </UniformGrid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
