<Window x:Class="TphdCemuTrainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TPHD Cemu Trainer"
        Height="760"
        MinHeight="680"
        Width="1120"
        MinWidth="980"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F0F0F0" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FAFAFA" />
        <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ReadOnlyBackgroundBrush" Color="#F7F7F7" />
        <SolidColorBrush x:Key="TextBrush" Color="#111111" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#555555" />
        <SolidColorBrush x:Key="BorderBrush" Color="#B8B8B8" />
        <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#FFF8E6" />
        <SolidColorBrush x:Key="WarningBorderBrush" Color="#D9A23A" />
        <SolidColorBrush x:Key="WarningTextBrush" Color="#6F4700" />
        <SolidColorBrush x:Key="ChangedRowBackgroundBrush" Color="#FFF3C4" />
        <SolidColorBrush x:Key="StrongCandidateBackgroundBrush" Color="#DFF4E7" />
        <SolidColorBrush x:Key="ChangedBitBackgroundBrush" Color="#FFC64D" />
        <SolidColorBrush x:Key="StatusNeutralBrush" Color="#808080" />
        <SolidColorBrush x:Key="TabSelectedBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TabUnselectedBackgroundBrush" Color="#E8E8E8" />
        <SolidColorBrush x:Key="TabHoverBackgroundBrush" Color="#F4F4F4" />
        <SolidColorBrush x:Key="TabSelectedTextBrush" Color="#111111" />
        <SolidColorBrush x:Key="DisabledTextBrush" Color="#777777" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="25" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="25" />
            <Setter Property="MinWidth" Value="98" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="7" />
            <Setter Property="Padding" Value="9" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Background" Value="{DynamicResource TabUnselectedBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ContentSite"
                                              ContentSource="Header"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource TabSelectedBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TabSelectedTextBrush}" />
                                <Setter Property="Panel.ZIndex" Value="1" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource TabHoverBackgroundBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource TabSelectedBackgroundBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="RowBackground" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource ReadOnlyBackgroundBrush}" />
        </Style>

        <DataTemplate x:Key="EditableValueTemplate">
            <Grid Margin="0,4" ToolTip="{Binding Source}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="135" />
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="82" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding Name}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <TextBox Grid.Column="1"
                         Text="{Binding CurrentValue, Mode=OneWay}"
                         IsReadOnly="True"
                         Background="{DynamicResource ReadOnlyBackgroundBrush}" />
                <TextBox Grid.Column="2"
                         Text="{Binding TargetValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Margin="6,0,0,0" />
                <Button Grid.Column="3"
                        Content="Set"
                        Tag="{Binding}"
                        Click="SetValue_Click" />
                <Button Grid.Column="4"
                        Content="Max"
                        Tag="{Binding}"
                        Click="MaxValue_Click" />
                <CheckBox Grid.Column="5"
                          Content="{Binding LockText}"
                          IsChecked="{Binding IsLocked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          IsEnabled="{Binding CanLock}"
                          VerticalAlignment="Center"
                          Margin="6,0,0,0" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="PoeSoulsValueTemplate">
            <Grid Margin="0,4" ToolTip="{Binding Source}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="135" />
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding Name}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <TextBox Grid.Column="1"
                         Text="{Binding CurrentValue, Mode=OneWay}"
                         IsReadOnly="True"
                         Background="{DynamicResource ReadOnlyBackgroundBrush}" />
                <TextBox Grid.Column="2"
                         Text="{Binding TargetValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Margin="6,0,0,0" />
                <Button Grid.Column="3"
                        Content="Set"
                        Tag="{Binding}"
                        Click="SetPoeSouls_Click" />
                <Button Grid.Column="4"
                        Content="Max"
                        Tag="{Binding}"
                        Click="MaxPoeSouls_Click" />
                <TextBlock Grid.Column="5"
                           Text="0-60"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ReadOnlyRawValueTemplate">
            <Grid Margin="0,3" ToolTip="{Binding Source}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="135" />
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="112" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Offset}"
                           FontFamily="Consolas"
                           VerticalAlignment="Center" />
                <TextBox Grid.Column="2"
                         Text="{Binding CurrentValue, Mode=OneWay}"
                         IsReadOnly="True"
                         Background="{DynamicResource ReadOnlyBackgroundBrush}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CapacityTemplate">
            <Grid Margin="0,4" ToolTip="{Binding Source}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="135" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="130" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Options}"
                          DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          SelectionChanged="CapacityCombo_SelectionChanged"
                          Tag="{Binding}" />
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}">
                    <Run Text="Stored:" />
                    <Run Text="{Binding CurrentStoredValue, Mode=OneWay}" />
                </TextBlock>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FutureCheckTemplate">
            <CheckBox Content="{Binding Name}"
                      IsEnabled="False"
                      ToolTip="{Binding Notes}"
                      Margin="0,3" />
        </DataTemplate>

        <DataTemplate x:Key="FutureTextTemplate">
            <TextBlock Text="{Binding Name}"
                       ToolTip="{Binding Notes}"
                       Margin="0,3"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
        </DataTemplate>

        <DataTemplate x:Key="InventoryOwnershipItemTemplate">
            <Border BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="0,5"
                    ToolTip="{Binding Notes}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" MinWidth="220" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding Name}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding CurrentDetectedState, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="6,0" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding IsOwnedDetected, Mode=OneWay}"
                               VerticalAlignment="Center"
                               Margin="6,0" />
                    <CheckBox Grid.Column="3"
                              IsChecked="{Binding IsOwnedDesired, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding CanEdit}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4"
                               Text="{Binding IsDirty, Mode=OneWay}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="5"
                               Text="{Binding FlagLocation}"
                               Foreground="{DynamicResource WarningTextBrush}"
                               VerticalAlignment="Center"
                               Margin="6,0" />
                    <TextBlock Grid.Column="6"
                               Text="{Binding EditStatus}"
                               ToolTip="{Binding EditStatus}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               VerticalAlignment="Center"
                               Margin="6,0" />
                    <TextBlock Grid.Column="7"
                               Text="{Binding KnownSlotText}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="6,0" />
                    <TextBlock Grid.Column="8"
                               Text="{Binding ExperimentalStatus}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="6,0" />
                    <TextBlock Grid.Column="9"
                               Text="{Binding Notes}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="6,0" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="InventorySlotReadOnlyTemplate">
            <Border BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="0,4"
                    ToolTip="{Binding Notes}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="*" MinWidth="150" />
                        <ColumnDefinition Width="166" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding SlotLabel}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Offset}"
                               FontFamily="Consolas"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding CurrentItemId, Mode=OneWay}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding CurrentItemName, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4"
                               Text="{Binding ManagementStatus}"
                               Foreground="{DynamicResource WarningTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="6,0" />
                    <TextBlock Grid.Column="5"
                               Text="{Binding Notes}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="6,0" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="InventorySlotTemplate">
            <Border BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="*" MinWidth="150" />
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="62" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding SlotNumber}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Offset}"
                               FontFamily="Consolas"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding CurrentItemId, Mode=OneWay}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding CurrentItemName, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4"
                               Text="{Binding ManagementStatus}"
                               Foreground="{DynamicResource WarningTextBrush}"
                               VerticalAlignment="Center"
                               Margin="6,0" />
                    <ComboBox Grid.Column="5"
                              ItemsSource="{Binding AvailableItems}"
                              DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Margin="6,0" />
                    <Button Grid.Column="6"
                            Content="Apply"
                            IsEnabled="{Binding CanEdit}"
                            Tag="{Binding}"
                            Click="ApplyInventorySlot_Click" />
                    <Button Grid.Column="7"
                            Content="Clear"
                            IsEnabled="{Binding CanEdit}"
                            Tag="{Binding}"
                            Click="ClearInventorySlot_Click" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="BottleSlotTemplate">
            <Border BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="106" />
                        <ColumnDefinition Width="*" MinWidth="150" />
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding BottleSlotNumber}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Offset}"
                               FontFamily="Consolas"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding CurrentRawValue}"
                               FontFamily="Consolas"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding CurrentDecodedContent}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <ComboBox Grid.Column="4"
                              ItemsSource="{Binding AvailableContents}"
                              DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding SelectedContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Margin="6,0" />
                    <TextBlock Grid.Column="5"
                               Text="{Binding Status}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="6,0" />
                    <Button Grid.Column="6"
                            Content="Apply"
                            IsEnabled="{Binding CanEdit}"
                            Tag="{Binding}"
                            Click="ApplyBottleSlot_Click" />
                    <Button Grid.Column="7"
                            Content="Set Nothing"
                            IsEnabled="{Binding CanEdit}"
                            Tag="{Binding}"
                            Click="ClearBottleSlot_Click" />
                    <Button Grid.Column="8"
                            Content="Restore"
                            IsEnabled="{Binding CanRestore}"
                            Tag="{Binding}"
                            Click="RestoreBottleSlot_Click" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="BottleDiagnosticTemplate">
            <Border BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" MinWidth="260" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding BottleSlotNumber}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Offset}"
                               FontFamily="Consolas"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding CurrentRawValue}"
                               FontFamily="Consolas"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding PreviousRawValue}"
                               FontFamily="Consolas"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4"
                               Text="{Binding LastWriteResult}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="6,0" />
                    <TextBlock Grid.Column="5"
                               Text="{Binding LastVerificationResult}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="6,0" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="InventoryRemovalItemTemplate">
            <Border BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="160" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="118" />
                        <ColumnDefinition Width="118" />
                        <ColumnDefinition Width="126" />
                        <ColumnDefinition Width="*" MinWidth="150" />
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="74" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding CurrentItemName}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding SlotNumber}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding Offset}"
                               FontFamily="Consolas"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding CurrentRawValue}"
                               FontFamily="Consolas"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4"
                               Text="{Binding PreviousRawValue}"
                               FontFamily="Consolas"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="5"
                               Text="{Binding PreviousItemName}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="6"
                               Text="{Binding RemovalTimestampText}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="7"
                               Text="{Binding Status}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="8"
                            Content="Remove"
                            IsEnabled="{Binding CanRemove}"
                            Tag="{Binding}"
                            Click="RemoveInventoryVisibleItem_Click" />
                    <Button Grid.Column="9"
                            Content="Restore"
                            IsEnabled="{Binding CanRestore}"
                            Tag="{Binding}"
                            Click="RestoreInventoryVisibleItem_Click" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="InventoryMappingItemTemplate">
            <Border BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" MinWidth="140" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding SlotNumber}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Offset}" FontFamily="Consolas" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding RawValueText}" FontFamily="Consolas" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding DecodedItem}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{Binding DetectedVisualGroup}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="5"
                              ItemsSource="{Binding AvailableResearchGroups}"
                              SelectedItem="{Binding SelectedResearchGroup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Margin="6,0" />
                    <TextBox Grid.Column="6"
                             Text="{Binding RowNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="6,0" />
                    <TextBox Grid.Column="7"
                             Text="{Binding ColumnNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="6,0" />
                    <TextBox Grid.Column="8"
                             Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="6,0" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="EquipmentSlotTemplate">
            <Border BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="0,5"
                    ToolTip="{Binding Source}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="*" MinWidth="150" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding Name}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Offset}"
                               FontFamily="Consolas"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding CurrentValue, Mode=OneWay}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding CurrentName, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="EquipmentFlagTemplate">
            <Border BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="0,5"
                    ToolTip="{Binding Source}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="180" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="52" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Content="{Binding Name}"
                              IsChecked="{Binding IsOwnedDesired, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding CanEdit}"
                              VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding IsOwnedDetected, Mode=OneWay}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding Offset}"
                               FontFamily="Consolas"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding Bit}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4"
                               Text="{Binding BackingValue, Mode=OneWay}"
                               FontFamily="Consolas"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="5"
                               Text="{Binding IsDirty, Mode=OneWay}"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ResearchRangeRowTemplate">
            <Border BorderBrush="{DynamicResource BorderBrush}"
