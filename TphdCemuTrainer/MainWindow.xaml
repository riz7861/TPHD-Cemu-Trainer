                                    <TextBlock Grid.Column="2"
                                               Text="Offset"
                                               Visibility="{Binding DeveloperToolsVisibility}"
                                               Margin="0,0,12,0"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3"
                                               Text="Bit"
                                               Visibility="{Binding DeveloperToolsVisibility}"
                                               Margin="0,0,12,0"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="4"
                                               Text="Pending Changes"
