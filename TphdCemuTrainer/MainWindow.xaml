                                                     Background="{DynamicResource ReadOnlyBackgroundBrush}" />
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="140" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Completed upgrades" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1"
                                                     x:Name="HeartProgressCompletedText"
                                                     Text="Not read"
                                                     IsReadOnly="True"
                                                     Background="{DynamicResource ReadOnlyBackgroundBrush}" />
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="70" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Set partial progress" VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding HeartProgressOptions}"
                                                      SelectedItem="{Binding SelectedHeartProgressOption, Mode=TwoWay}"
                                                      Margin="0,0,6,0" />
                                            <Button Grid.Column="2"
                                                    Content="Apply"
                                                    Click="ApplyHeartProgress_Click" />
                                        </Grid>
                                        <TextBox x:Name="HeartProgressStatusText"
                                                 Text="Attach to Cemu and rescan to read heart progress."
                                                 IsReadOnly="True"
                                                 TextWrapping="Wrap"
                                                 Background="{DynamicResource ReadOnlyBackgroundBrush}"
                                                 Margin="0,4,0,0" />
                                        <Grid Margin="0,4,0,0"
                                              Visibility="{Binding DeveloperToolsVisibility}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="140" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Raw progress (0x1BF)" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1"
                                                     x:Name="HeartProgressRawText"
                                                     Text="Not read"
                                                     IsReadOnly="True"
                                                     FontFamily="Consolas"
                                                     Background="{DynamicResource ReadOnlyBackgroundBrush}" />
                                        </Grid>
                                    </StackPanel>
                                </GroupBox>
                                <ContentControl Content="{Binding LanternOil}"
                                                ContentTemplate="{StaticResource EditableValueTemplate}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Wallet">
                            <StackPanel>
                                <ContentControl Content="{Binding WalletCapacity}"
                                                ContentTemplate="{StaticResource CapacityTemplate}" />
                                <ContentControl Content="{Binding Rupees}"
                                                ContentTemplate="{StaticResource EditableValueTemplate}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Collectibles Summary">
