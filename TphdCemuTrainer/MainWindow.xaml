                                                  VerticalAlignment="Center"
                                                  Margin="14,0,0,0" />
                                        <CheckBox Content="Allow editing uninitialized inventory"
                                                  IsChecked="{Binding AllowEditingUninitializedInventory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="Allows Apply/Clear while all 24 CT inventory slots read as 255 / Nothing."
                                                  VerticalAlignment="Center"
                                                  Margin="14,0,0,0" />
                                    </StackPanel>

                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="54" />
                                            <ColumnDefinition Width="74" />
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="*" MinWidth="150" />
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="260" />
                                            <ColumnDefinition Width="62" />
                                            <ColumnDefinition Width="62" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Slot" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="Offset" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="Item ID" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="3" Text="Current item" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="4" Text="Status" FontWeight="SemiBold" Margin="6,0" />
                                        <TextBlock Grid.Column="5" Text="Replacement item" FontWeight="SemiBold" Margin="6,0" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding InventorySlots}"
                                                  ItemTemplate="{StaticResource InventorySlotTemplate}" />
                                </StackPanel>
                            </GroupBox>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Equipment">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6">
                        <GroupBox Header="Equipment Editor">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="#7A4A00"
                                           Margin="0,0,0,8"
                                           Text="Ownership flags are the authoritative equipment data. Grant ownership here, then equip owned items through the in-game equipment screen." />

                                <Border BorderBrush="#D9A23A"
                                        BorderThickness="1"
                                        Background="#FFF8E6"
                                        Padding="8"
                                        Margin="0,0,0,8">
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="#6F4700"
                                               FontWeight="SemiBold"
                                               Text="Changes may not appear immediately if the equipment screen is currently open. Close the in-game equipment menu and reopen it to refresh the displayed equipment." />
                                </Border>

                                <Border x:Name="EquipmentInitializationWarningText"
                                        Visibility="Collapsed"
                                        BorderBrush="#D9A23A"
                                        BorderThickness="1"
                                        Background="#FFF8E6"
                                        Padding="8"
                                        Margin="0,0,0,8">
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="#6F4700"
                                               FontWeight="SemiBold"
                                               Text="Equipment has not been initialized by the game yet.&#x0a;&#x0a;Progress until Link obtains equipment, then click Attach / Rescan." />
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="Refresh Equipment"
                                            Click="RefreshEquipmentButton_Click" />
                                    <CheckBox Content="Allow editing uninitialized equipment"
                                              IsChecked="{Binding AllowEditingUninitializedEquipment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="Allows ownership flag writes while the CT equipment bytes appear uninitialized."
                                              VerticalAlignment="Center"
                                              Margin="12,0,0,0" />
                                    <Button Content="Apply Ownership Changes"
                                            Click="ApplyEquipmentOwnership_Click"
                                            Margin="12,0,0,0" />
                                    <TextBlock Text="Equipment should be equipped through the in-game menu after ownership is granted."
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"
                                               Foreground="#555" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Owned Equipment">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="#555"
                                           Margin="0,0,0,8"
                                           Text="Checkboxes edit desired ownership. Detected ownership is read from memory and dirty rows are preserved across background refresh until Apply Ownership Changes is clicked." />
                                <UniformGrid Columns="3">
                                    <GroupBox Header="Swords">
                                        <ItemsControl ItemsSource="{Binding SwordOwnershipFlags}"
                                                      ItemTemplate="{StaticResource EquipmentFlagTemplate}" />
                                    </GroupBox>
                                    <GroupBox Header="Shields">
                                        <ItemsControl ItemsSource="{Binding ShieldOwnershipFlags}"
                                                      ItemTemplate="{StaticResource EquipmentFlagTemplate}" />
                                    </GroupBox>
                                    <GroupBox Header="Armor">
                                        <ItemsControl ItemsSource="{Binding ArmorOwnershipFlags}"
                                                      ItemTemplate="{StaticResource EquipmentFlagTemplate}" />
                                    </GroupBox>
                                </UniformGrid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Current Equipment (Read Only)">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="#555"
                                           Margin="0,0,0,8"
                                           Text="Current equipment values are game-managed and are shown for diagnostics only." />
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="*" MinWidth="150" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Slot" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Offset" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="Value" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Current" FontWeight="SemiBold" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding EquipmentSlots}"
                                              ItemTemplate="{StaticResource EquipmentSlotTemplate}" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Ammo &amp; Upgrades">
