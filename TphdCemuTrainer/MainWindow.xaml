                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           TextWrapping="NoWrap"
                                                           Margin="0,0,0,4" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Expander>
                        </StackPanel>
                    </GroupBox>
                        </StackPanel>
                    </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Story Flags">
