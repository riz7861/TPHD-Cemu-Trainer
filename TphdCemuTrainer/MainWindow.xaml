                                         TextWrapping="Wrap"
                                         Background="#F7F7F7" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="AOB Scan Diagnostics">
                            <StackPanel>
                                <TextBlock Text="Also written to logs/scan.log after Attach / Rescan"
                                           Foreground="#555"
                                           Margin="0,0,0,6" />
