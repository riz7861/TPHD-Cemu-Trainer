                        </GroupBox>

                        <GroupBox Header="Research">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,0,8"
                                           Text="Watch one playerbase-relative byte while playing to help identify real ownership or progression flags." />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Relative offset"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,5" />
                                    <TextBox Grid.Column="1"
                                             x:Name="ResearchOffsetText"
                                             Text="0x26C"
                                             FontFamily="Consolas"
                                             Margin="0,0,6,5" />
                                    <Button Grid.Column="2"
                                            Content="Read Byte"
                                            Click="ResearchReadByte_Click"
                                            Margin="0,0,0,5" />

                                    <TextBlock Grid.Row="1"
                                               Text="Absolute address"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,5" />
                                    <TextBox Grid.Row="1"
                                             Grid.Column="1"
                                             Grid.ColumnSpan="2"
                                             x:Name="ResearchAbsoluteAddressText"
                                             Text="-"
                                             IsReadOnly="True"
                                             FontFamily="Consolas"
                                             Background="{DynamicResource ReadOnlyBackgroundBrush}"
                                             Margin="0,0,0,5" />

                                    <TextBlock Grid.Row="2"
                                               Text="Current byte"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,5" />
                                    <TextBox Grid.Row="2"
                                             Grid.Column="1"
                                             Grid.ColumnSpan="2"
                                             x:Name="ResearchCurrentByteText"
                                             Text="Not read"
                                             IsReadOnly="True"
                                             FontFamily="Consolas"
                                             Background="{DynamicResource ReadOnlyBackgroundBrush}"
                                             Margin="0,0,0,5" />

                                    <CheckBox Grid.Row="3"
                                              Grid.Column="1"
                                              Grid.ColumnSpan="2"
                                              x:Name="ResearchAutoRefreshCheckBox"
                                              Content="Auto refresh while attached"
                                              Margin="0,0,0,5" />

                                    <TextBlock Grid.Row="4"
                                               Text="Snapshot"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,5" />
                                    <StackPanel Grid.Row="4"
                                                Grid.Column="1"
                                                Grid.ColumnSpan="2"
                                                Orientation="Horizontal"
                                                Margin="0,0,0,5">
                                        <TextBox x:Name="ResearchSnapshotByteText"
                                                 Text="Not captured"
                                                 IsReadOnly="True"
                                                 FontFamily="Consolas"
                                                 Background="{DynamicResource ReadOnlyBackgroundBrush}"
                                                 Width="150" />
                                        <Button Content="Capture"
                                                Click="ResearchCaptureSnapshot_Click" />
                                        <Button Content="Compare"
                                                Click="ResearchCompareSnapshot_Click" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="5"
                                               Text="Compare"
