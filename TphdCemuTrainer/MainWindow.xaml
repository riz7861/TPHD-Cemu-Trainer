                                            Click="AddAllHiddenSkills_Click"
                                            Margin="6,0,0,0" />
                                    <Button Content="Clear All Hidden Skills"
                                            Click="ClearAllHiddenSkills_Click"
                                            Margin="6,0,0,0" />
