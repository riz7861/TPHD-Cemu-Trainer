                                    </Grid>

                                    <ScrollViewer Height="390"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Background="{DynamicResource ReadOnlyBackgroundBrush}">
                                        <ItemsControl ItemsSource="{Binding InventoryOwnershipItems}"
                                                      ItemTemplate="{StaticResource InventoryFriendlyItemTemplate}" />
                                    </ScrollViewer>
                                </StackPanel>
                            </GroupBox>

                            <Border BorderBrush="{DynamicResource WarningBorderBrush}"
                                    BorderThickness="1"
                                    Background="{DynamicResource WarningBackgroundBrush}"
                                    Padding="8"
                                    Margin="7">
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{DynamicResource WarningTextBrush}"
                                           Text="Some items may require story progress before they work correctly in-game. Back up your save before editing. Close and reopen the in-game inventory menu after applying changes." />
                            </Border>

                            <GroupBox Header="Bottles">
                                <StackPanel>
                                    <Grid Margin="4,0,4,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" MinWidth="170" />
                                            <ColumnDefinition Width="240" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="94" />
                                            <ColumnDefinition Width="76" />
                                        </Grid.ColumnDefinitions>
