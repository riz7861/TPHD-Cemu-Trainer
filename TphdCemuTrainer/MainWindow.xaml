                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="54" />
                                        <ColumnDefinition Width="74" />
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" MinWidth="260" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Slot" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Offset" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="Current" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Previous" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="4" Text="Last write" FontWeight="SemiBold" Margin="6,0" />
                                    <TextBlock Grid.Column="5" Text="Last verification" FontWeight="SemiBold" Margin="6,0" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding BottleSlots}"
                                              ItemTemplate="{StaticResource BottleDiagnosticTemplate}" />

                                <ScrollViewer Height="170"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto"
                                              Background="{DynamicResource ReadOnlyBackgroundBrush}"
                                              Margin="0,8,0,0">
                                    <ItemsControl ItemsSource="{Binding BottleEditorDiagnostics}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           TextWrapping="NoWrap"
                                                           Margin="0,0,0,4" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Collectibles Diagnostics">
                            <StackPanel>
                                <TextBlock Text="Also written to logs/collectibles.log"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,0,6" />
                                <ScrollViewer Height="190"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto"
                                              Background="{DynamicResource ReadOnlyBackgroundBrush}">
                                    <ItemsControl ItemsSource="{Binding CollectiblesDiagnostics}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           TextWrapping="NoWrap"
                                                           Margin="0,0,0,4" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Equipment Diagnostics">
                            <StackPanel>
                                <TextBlock Text="Also written to logs/equipment.log"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,0,6" />
                                <ScrollViewer Height="190"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto"
                                              Background="{DynamicResource ReadOnlyBackgroundBrush}">
                                    <ItemsControl ItemsSource="{Binding EquipmentDiagnostics}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           TextWrapping="NoWrap"
                                                           Margin="0,0,0,4" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Advanced Tools">
                            <ItemsControl ItemsSource="{Binding DebugTools}"
                                          ItemTemplate="{StaticResource FutureTextTemplate}" />
                        </GroupBox>

                        <GroupBox Header="Coordinate Display">
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="Coordinate display and teleport tools are reserved for a future coordinate-base scan implementation." />
                        </GroupBox>
                    </UniformGrid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
