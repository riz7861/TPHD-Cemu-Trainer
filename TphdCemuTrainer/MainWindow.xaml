                                        <TextBlock Grid.Column="1" Text="Current" FontWeight="SemiBold" Margin="8,0" />
                                        <TextBlock Grid.Column="2" Text="Change" FontWeight="SemiBold" Margin="8,0" />
                                        <TextBlock Grid.Column="3" Text="Apply" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="4" Text="Remove" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="5" Text="Undo" FontWeight="SemiBold" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding BottleSlots}"
                                                  ItemTemplate="{StaticResource BottleFriendlySlotTemplate}" />
                                    <TextBlock Text="Bottle contents can be changed independently. Back up your save before editing."
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="4,7,4,0" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>

                        <Expander Header="Developer / Research Details"
                                  IsExpanded="False"
                                  Visibility="{Binding DeveloperToolsVisibility}">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{DynamicResource WarningTextBrush}"
                                           Margin="0,0,0,8"
                                           Text="Inventory ownership/progression flags have not been mapped yet. Known items are detected from visible inventory data. The fixed-slot editor below edits visible slots only; it does not set story progression." />

                                <Border BorderBrush="{DynamicResource WarningBorderBrush}"
                                        BorderThickness="1"
                                        Background="{DynamicResource WarningBackgroundBrush}"
                                        Padding="8"
                                        Margin="0,0,0,8">
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{DynamicResource WarningTextBrush}"
                                               FontWeight="SemiBold"
                                               Text="This edits fixed visible inventory slots, not story progression. Some items may appear but be unusable until story flags or related state are set. Button assignments are separate from inventory slots." />
                                </Border>

                                <Border BorderBrush="{DynamicResource WarningBorderBrush}"
                                        BorderThickness="1"
                                        Background="{DynamicResource WarningBackgroundBrush}"
                                        Padding="8"
                                        Margin="0,0,0,8">
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{DynamicResource WarningTextBrush}"
                                               FontWeight="SemiBold"
                                               Text="Fixed-slot inventory changes may not appear if the in-game inventory menu is already open. Close and reopen the inventory menu after applying changes." />
                                </Border>

                                <Border x:Name="InventoryOwnershipAcceptanceWarningText"
                                        Visibility="Collapsed"
                                        BorderBrush="{DynamicResource WarningBorderBrush}"
                                        BorderThickness="1"
                                        Background="{DynamicResource WarningBackgroundBrush}"
                                        Padding="8"
                                        Margin="0,0,0,8">
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{DynamicResource WarningTextBrush}"
                                               FontWeight="SemiBold"
                                               Text="This save appears to be before TPHD begins honoring ownership edits. Progress past the Ordon Village intro arc and rescan." />
                                </Border>

                                <Border x:Name="InventoryInitializationWarningText"
                                        Visibility="Collapsed"
                                        BorderBrush="{DynamicResource WarningBorderBrush}"
                                        BorderThickness="1"
                                        Background="{DynamicResource WarningBackgroundBrush}"
                                        Padding="8"
                                        Margin="0,0,0,8">
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{DynamicResource WarningTextBrush}"
                                               FontWeight="SemiBold"
                                               Text="Inventory has not been initialized by the game yet.&#x0a;&#x0a;You appear to be at a very early point in the story.&#x0a;&#x0a;Progress until Link obtains a real inventory item (Fishing Rod, Slingshot, Lantern, etc.) then click Attach / Rescan." />
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="Refresh Inventory"
                                            Click="RefreshInventoryButton_Click" />
                                    <Button x:Name="ApplyInventoryOwnershipButton"
                                            Content="Apply Inventory Ownership Changes"
                                            Visibility="{Binding DeveloperToolsVisibility}"
                                            Click="ApplyInventoryOwnership_Click"
                                            Margin="12,0,0,0" />
                                    <TextBlock Text="Visible inventory slots are game-managed and read-only."
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>

                                <WrapPanel Margin="0,0,0,8">
                                    <CheckBox Content="I am past the Ordon Village intro arc"
                                              IsChecked="{Binding UserConfirmedPastIntroArc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="Uses a manual override for the ownership-edit acceptance heuristic."
                                              VerticalAlignment="Center"
                                              Margin="0,0,18,6" />
                                    <CheckBox Content="Allow ownership edits before intro completion"
                                              IsChecked="{Binding AllowOwnershipEditsBeforeIntroCompletion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="Bypasses the conservative early-save guard for mapped ownership flags."
                                              VerticalAlignment="Center"
                                              Margin="0,0,18,6" />
                                </WrapPanel>

                                <Border BorderBrush="{DynamicResource WarningBorderBrush}"
                                        BorderThickness="1"
                                        Background="{DynamicResource WarningBackgroundBrush}"
                                        Padding="8"
                                        Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock TextWrapping="Wrap"
                                                   Foreground="{DynamicResource WarningTextBrush}"
                                                   FontWeight="SemiBold"
                                                   Text="Fixed Slot Inventory Editor / Experimental. Checked writes the row's detected or static fixed-slot item ID to its fixed visible slot. Unchecked writes 0xFF / Nothing to remove it. This is not solved ownership and may revert or fail to appear in-game if related progression state is missing." />
                                        <TextBlock TextWrapping="Wrap"
                                                   Foreground="{DynamicResource WarningTextBrush}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,6,0,0"
                                                   Text="Use only one Clawshot variant. Enabling both can hide or displace another progression item such as the Dominion Rod." />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <CheckBox Content="Enable fixed-slot inventory editor / experimental"
                                                      IsChecked="{Binding EnableExperimentalInventoryCheckboxWrites, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,12,0" />
                                            <Button Content="Apply Fixed-Slot Inventory Changes"
                                                    IsEnabled="{Binding ElementName=ApplyInventoryCheckboxTestingButton, Path=IsEnabled}"
                                                    Click="ApplyInventoryCheckboxTesting_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="210" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="74" />
                                        <ColumnDefinition Width="54" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" MinWidth="220" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Item" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Current detected state" FontWeight="SemiBold" Margin="6,0" />
                                    <TextBlock Grid.Column="2"
                                               Text="Detected"
                                               FontWeight="SemiBold"
                                               Visibility="{Binding DeveloperToolsVisibility}"
                                               Margin="6,0" />
                                    <TextBlock Grid.Column="3" Text="Desired edit" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="Dirty" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="5"
                                               Text="Ownership flag"
                                               FontWeight="SemiBold"
                                               Visibility="{Binding DeveloperToolsVisibility}"
                                               Margin="6,0" />
                                    <TextBlock Grid.Column="6" Text="Fixed-slot status" FontWeight="SemiBold" Margin="6,0" />
                                    <TextBlock Grid.Column="7"
                                               Text="Known slot"
                                               FontWeight="SemiBold"
                                               Visibility="{Binding DeveloperToolsVisibility}"
                                               Margin="6,0" />
                                    <TextBlock Grid.Column="8" Text="Write status" FontWeight="SemiBold" Margin="6,0" />
                                    <TextBlock Grid.Column="9" Text="Notes" FontWeight="SemiBold" Margin="6,0" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding InventoryOwnershipItems}"
                                              ItemTemplate="{StaticResource InventoryOwnershipItemTemplate}" />
                            </StackPanel>
                        </Expander>

                        <GroupBox Header="Current Inventory Slots (Read Only)"
                                  Visibility="{Binding DeveloperToolsVisibility}">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,0,8"
                                           Text="These 24 bytes are CT-derived visible inventory fields from _playerbase+0x258 through _playerbase+0x26F. They are shown for detection and research; normal inventory editing does not write them." />

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="74" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="*" MinWidth="150" />
                                        <ColumnDefinition Width="166" />
                                        <ColumnDefinition Width="300" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Slot" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Offset" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="Raw item ID" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Decoded item name" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="4" Text="Managed field" FontWeight="SemiBold" Margin="6,0" />
                                    <TextBlock Grid.Column="5" Text="Notes" FontWeight="SemiBold" Margin="6,0" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding InventorySlots}"
                                              ItemTemplate="{StaticResource InventorySlotReadOnlyTemplate}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Advanced Bottle Details"
                                  Visibility="{Binding DeveloperToolsVisibility}">
                            <StackPanel>
                                <Border BorderBrush="{DynamicResource WarningBorderBrush}"
                                        BorderThickness="1"
                                        Background="{DynamicResource WarningBackgroundBrush}"
                                        Padding="8"
                                        Margin="0,0,0,8">
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{DynamicResource WarningTextBrush}"
                                               FontWeight="SemiBold"
                                               Text="Bottle ownership and bottle contents are still being researched. Some values may represent bottle contents rather than bottle ownership. Use copied saves. This editor writes only the four bottle slots, does not automatically create bottle ownership, does not alter assigned button slots, and does not modify non-bottle inventory slots." />
                                </Border>

                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,0,8"
                                           Text="Confirmed bottle-slot values are enabled by default. Other Twilight Princess bottle contents are documented in docs/research/BottleResearch.md until their raw values are confirmed for this editor." />

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="84" />
                                        <ColumnDefinition Width="74" />
                                        <ColumnDefinition Width="106" />
                                        <ColumnDefinition Width="*" MinWidth="150" />
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="62" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Bottle" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Offset" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="Current raw" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Current content" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="4" Text="Desired content" FontWeight="SemiBold" Margin="6,0" />
                                    <TextBlock Grid.Column="5" Text="Status" FontWeight="SemiBold" Margin="6,0" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding BottleSlots}"
                                              ItemTemplate="{StaticResource BottleSlotTemplate}" />
                            </StackPanel>
                        </GroupBox>

                        <Expander Header="Inventory Mapping Mode (Research Only)"
                                  IsExpanded="False"
                                  Visibility="{Binding DeveloperToolsVisibility}">
                            <GroupBox Header="Inventory Mapping Mode">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Margin="0,0,0,8"
                                               Text="Read-only mapping surface for documenting how visible inventory slots appear grouped in-game. This does not write item values." />
                                    <Button Content="Export Inventory Mapping"
                                            HorizontalAlignment="Left"
                                            Click="ExportInventoryMapping_Click"
                                            Margin="0,0,0,8" />

                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="74" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" MinWidth="140" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="220" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Slot" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="Offset" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="Raw value" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="3" Text="Decoded item" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="4" Text="Detected visual group" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="5" Text="Research group" FontWeight="SemiBold" Margin="6,0" />
                                        <TextBlock Grid.Column="6" Text="Row note" FontWeight="SemiBold" Margin="6,0" />
                                        <TextBlock Grid.Column="7" Text="Column note" FontWeight="SemiBold" Margin="6,0" />
                                        <TextBlock Grid.Column="8" Text="Notes" FontWeight="SemiBold" Margin="6,0" />
                                    </Grid>

                                    <ScrollViewer Height="260"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  Background="{DynamicResource ReadOnlyBackgroundBrush}">
                                        <ItemsControl ItemsSource="{Binding InventoryMappingItems}"
                                                      ItemTemplate="{StaticResource InventoryMappingItemTemplate}" />
                                    </ScrollViewer>
                                </StackPanel>
                            </GroupBox>
                        </Expander>

                        <Expander Header="Advanced / Inventory Removal Testing (Unsafe)"
                                  IsExpanded="False"
                                  Visibility="{Binding DeveloperToolsVisibility}">
                            <GroupBox Header="Inventory Removal Tester">
                                <StackPanel>
                                    <Border BorderBrush="{DynamicResource WarningBorderBrush}"
                                            BorderThickness="1"
                                            Background="{DynamicResource WarningBackgroundBrush}"
                                            Padding="8"
                                            Margin="0,0,0,8">
                                        <TextBlock TextWrapping="Wrap"
                                                   Foreground="{DynamicResource WarningTextBrush}"
                                                   FontWeight="SemiBold"
                                                   Text="Inventory removal writes directly to visible game-managed slots. TPHD may revert them or the save may behave unexpectedly. Removing assigned items does not clear Y/X/R button assignments, and removed assigned items may remain usable until manually unequipped or replaced. Removing all primary/progression items may make bombs or bottles unreachable in the in-game inventory menu. Use copied saves only." />
                                    </Border>

                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Margin="0,0,0,8"
                                               Text="This research tool only writes 0xFF / Nothing to detected visible slots, then can restore the previous captured byte. Restore buffers are per-slot and session-only: they remain until restored, cleared, or the app closes. It does not add items and does not write ownership/progression flags." />

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Content="Restore All Removed Items"
                                                Click="RestoreAllInventoryRemovedItems_Click" />
                                        <Button Content="Clear Restore Buffer"
                                                Click="ClearInventoryRestoreBuffer_Click" />
                                    </StackPanel>

                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="160" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="74" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="118" />
                                            <ColumnDefinition Width="118" />
                                            <ColumnDefinition Width="126" />
                                            <ColumnDefinition Width="*" MinWidth="150" />
                                            <ColumnDefinition Width="74" />
                                            <ColumnDefinition Width="74" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Item" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="Slot" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="Offset" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="3" Text="Current raw" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="4" Text="Previous raw" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="5" Text="Previous item" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="6" Text="Removed at" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="7" Text="Status" FontWeight="SemiBold" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding InventoryRemovalItems}"
                                                  ItemTemplate="{StaticResource InventoryRemovalItemTemplate}" />
                                </StackPanel>
                            </GroupBox>
                        </Expander>

                        <Expander Header="Advanced / Raw Inventory Writes (Unsafe)"
                                  IsExpanded="False"
                                  Visibility="{Binding DeveloperToolsVisibility}">
                            <GroupBox Header="Unsafe Raw Inventory Writes">
                                <StackPanel>
                                    <Border BorderBrush="{DynamicResource WarningBorderBrush}"
                                            BorderThickness="1"
                                            Background="{DynamicResource WarningBackgroundBrush}"
                                            Padding="8"
                                            Margin="0,0,0,8">
                                        <TextBlock TextWrapping="Wrap"
                                                   Foreground="{DynamicResource WarningTextBrush}"
                                                   FontWeight="SemiBold"
                                                   Text="Raw inventory writes are experimental. TPHD may immediately revert invalid writes. Use only for research on copied saves." />
                                    </Border>

                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{DynamicResource WarningTextBrush}"
                                               Margin="0,0,0,8"
                                               Text="This section exposes all CT item IDs for diagnostics. Raw inventory slots are game-managed and may revert; the game likely rebuilds them from ownership/progression flags elsewhere." />

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <CheckBox Content="Enable unsafe raw inventory writes"
                                                  IsChecked="{Binding AllowUnsafeRawInventoryWrites, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="Required before Apply/Clear buttons in raw inventory mode can write bytes."
                                                  VerticalAlignment="Center" />
                                        <CheckBox Content="Hold inventory value for 2 seconds after Apply"
                                                  IsChecked="{Binding HoldInventoryValueAfterApply, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="Repeats the selected byte write for two seconds after Apply to test whether the game is overwriting the slot."
                                                  VerticalAlignment="Center"
                                                  Margin="14,0,0,0" />
                                        <CheckBox Content="Allow editing uninitialized inventory"
                                                  IsChecked="{Binding AllowEditingUninitializedInventory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="Allows Apply/Clear while all 24 CT inventory slots read as 255 / Nothing."
                                                  VerticalAlignment="Center"
                                                  Margin="14,0,0,0" />
                                    </StackPanel>

                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="54" />
                                            <ColumnDefinition Width="74" />
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="*" MinWidth="150" />
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="260" />
                                            <ColumnDefinition Width="62" />
                                            <ColumnDefinition Width="62" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Slot" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="Offset" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="Item ID" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="3" Text="Current item" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="4" Text="Status" FontWeight="SemiBold" Margin="6,0" />
                                        <TextBlock Grid.Column="5" Text="Replacement item" FontWeight="SemiBold" Margin="6,0" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding InventorySlots}"
