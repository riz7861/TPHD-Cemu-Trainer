<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="42">
  <CheatEntries>
    <CheatEntry>
      <ID>353</ID>
      <Description>"Activate"</Description>
      <Options moHideChildren="1"/>
      <Color>0000FF</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript Async="1">[ENABLE]
{$lua}
openProcess("Cemu.exe")
local timer = createTimer(getMainForm())
timer.Interval = 100
timer.OnTimer = function(timer)
  windowID = getForegroundWindow()
  if getWindowProcessID(windowID) == getOpenedProcessID() then
    timer.destroy()
  end
end
{$asm}

//aobscan(baseaddr,10 08 9B CC 00 00 00 01 18 3A ?? F0 10 08 9B C4)
//define(_baseaddr,baseaddr-1014518C)
//registersymbol(_baseaddr)



globalalloc(allocmem,3096)

//INFINITE HEARTS
define(healmem,allocmem+50)
registersymbol(healmem)

//INFINITE RUPEES
define(infrupeemem,allocmem+150)
registersymbol(infrupeemem)

define(rupBefore,allocmem+225)
registersymbol(rupBefore)

//INFINITE ARROWS
define(arrowmem,allocmem+250)
registersymbol(arrowmem)

//INFINITE BOMBS
define(bombsmem,allocmem+350)
registersymbol(bombsmem)

//INFINITE SEEDS
define(seedsmem,allocmem+450)
registersymbol(seedsmem)

//INFINITE OIL
define(oilmem,allocmem+550)
registersymbol(oilmem)

//RUPEES ALWAYS INCREASE
define(increasemem,allocmem+650)
registersymbol(increasemem)

//INVINCIBILITY
define(invinmem,allocmem+750)
registersymbol(invinmem)

//PLAYER COORDINATE HOOK
define(coordmem,allocmem+850)
registersymbol(coordmem)
define(_coordinates,allocmem+925)
registersymbol(_coordinates)
_coordinates:
  dd 0

//MOON JUMP
define(moonjmpmem,allocmem+950)
registersymbol(moonjmpmem)
define(offset,allocmem+1010)
registersymbol(offset)
define(pJmp,allocmem+1025)
registersymbol(pJmp)

//DAMAGE TAKEN MULTIPLIER
define(takedmgmem,allocmem+1050)
registersymbol(takedmgmem)

define(mult,allocmem+1125)
registersymbol(mult)

define(healthBefore,allocmem+1135)
registersymbol(healthBefore)

//DAMAGE GIVEN MULTIPLIER
define(multmem,allocmem+1150)
registersymbol(multmem)

define(pDmg_mult,allocmem+1225)
registersymbol(pDmg_mult)

//NO SPIN ATTACK CHARGE UP
define(quickmem,allocmem+1250)
registersymbol(quickmem)

//RUPEE MULTIPLIER
define(rupmultmem,allocmem+1350)
registersymbol(rupmultmem)

define(rupMultiplier,allocmem+1425)
registersymbol(rupMultiplier)

{$lua}
add_base_addr(read_file_lines())
memrec.Color=0x00FF00
{$asm}




[DISABLE]
{$lua}
local al = getAddressList()

for i = 0, al.Count - 1 do
  if al[i].Type == vtAutoAssembler then al[i].Active = false end
end

memrec.Color = 0x0000FF
{$asm}

dealloc(allocmem)
unregistersymbol(*)






