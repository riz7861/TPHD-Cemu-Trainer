                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript Async="1">{$lua}
if syntaxcheck then return end

[ENABLE]

--aobscan(dmgmult,D2 41 29 C2 4D 89 D6) // should be unique
--registersymbol(dmgmult)

giveDmgAOB = 0xD2, 0x41, 0x29

if readBytes(getAddressSafe("dmgmult"),3,false) == giveDmgAOB then
  giveDmgScan = getAddressSafe("dmgmult")
else
  giveDmgScan = AOBScan("D2 41 29 C2 4D 89 D6")[0]
  registerSymbol("dmgmult", giveDmgScan)
end


autoAssemble([[
label(return)

pDmg_mult:
  dd #1

multmem:
  push ebx
  pushf
  mov bl, [pDmg_mult]
  mul bl
  sub r10d,eax
  mov r14,r10
  pop ebx
  popf
  jmp return

dmgmult+01:
  jmp multmem
  nop
return:
]])

[DISABLE]
autoAssemble([[
dmgmult+01:
  db 41 29 C2 4D 89 D6
]])


</AssemblerScript>
