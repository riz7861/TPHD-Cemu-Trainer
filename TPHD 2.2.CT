  <Comments>Info about this table:
</Comments>
  <LuaScript>windowList = getWindowList()
function checkCemu()
  for s,v in pairs(windowList) do
    for i = 1, #v, 1 do
        if string.match(v[i], "Cemu 2") then
           return true
        end
    end
  end
  return false
end
--For adding offsets to AOB Scan results
function addOffset(scan, num)
  if num == string then
    num = tonumber(num,16)
  else
    num = tonumber(tostring(num),16)
  end
  return string.format("%X", tostring(tonumber(scan,16)+num))
end

--function to find the location of the log folder
function get_log_loc()
  cemu_loc = enumModules()[1].PathToFile
  log_loc = string.gsub(cemu_loc,"Cemu.exe","log.txt")
  return log_loc
end
--read the log file lines and finds the base address of cemu
function read_file_lines()
  local lines = {}

  for line in io.lines(get_log_loc()) do
    lines[#lines + 1] = line
  end

  for i = 1, #lines, 1 do
    found = string.find(lines[i], "base:")
    if found then
      return string.sub(lines[i],found+13,string.len(lines[i])-1)
    end
  end

end
--Adds the base address as a symbol for cheat engine to detect
--and updates the Cemu base address on cheat engine
function add_base_addr(address)
  local baseAddr = getAddressList().getMemoryRecordByDescription("CEMU BASE ADDRESS")
  baseAddr.Address = address
  registerSymbol("_baseaddr", address)
end
----------------------ADDS THE COMPACT MENU OPTION-----------------------
function cycleFullCompact( sender, force )
  local state = not( compactmenuitem.Caption == 'Compact View Mode' )
  if force ~= nil then
    state = not force
  end
  compactmenuitem.Caption = state and 'Compact View Mode' or 'Full View Mode'
  getMainForm().Splitter1.Visible = state
  getMainForm().Panel4.Visible = state
  getMainForm().Panel5.Visible = state
end

function addCompactMenu()
  if compactmenualreadyexists then return end
    local parent = getMainForm().Menu.Items
    compactmenuitem = createMenuItem( parent )
    parent.add( compactmenuitem )
    compactmenuitem.Caption = 'Compact View Mode'
    compactmenuitem.OnClick = cycleFullCompact
    compactmenualreadyexists = 'yes'
end
addCompactMenu()
