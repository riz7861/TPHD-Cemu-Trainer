                  <ID>227722</ID>
                  <Description>"Moon Jump (ZR + A , set Cemu to PRO controller if not working)"</Description>
                  <Options moHideChildren="1"/>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript Async="1">{$lua}
if syntaxcheck then return end
[ENABLE]

--aobscan(moonjmp,45 0F 38 F1 B4 15 FC 04 00 00 89 D7 89 7C 24 10 66 0F 11 84 E4 F8) // should be unique
--registersymbol(moonjmp)
moonJmpAOB = 0x45, 0x0F, 0x38
moonJmpAOB2 = 0x45, 0x0F, 0x38


if readBytes(getAddressSafe("moonjmp"),3,false) == moonJmpAOB then
   moonJmpScan = getAddressSafe("moonjmp")
else
    moonJmpScan = AOBScan("45 0F 38 F1 B4 15 FC 04 00 00 89 D7 89 7C 24 10 66 0F 11 84 E4 F8")[0]
    registerSymbol("moonjmp", moonJmpScan)
end

if readBytes(getAddressSafe("moonjmp2"),3,false) == moonJmpAOB2 then
   moonJmpScan2 = getAddressSafe("moonjmp2")
else
    moonJmpScan2 = AOBScan("45 0F 38 F1 B4 15 FC 04 00 00 66 0F 11 84 E4 08 01 00 00 83")[0]
    registerSymbol("moonjmp2", moonJmpScan2)
end

if checkCemu() then
  autoAssemble([[
  offset:
    db 33 86 74 12
  ]])
  print("True")
else
  autoAssemble([[
  offset:
    db 33 8A 74 12
  ]])
  print("False")
end

autoAssemble([[
label(originalcode)
label(return)

pJmp:
 db 42 5C 00 00

moonjmpmem:
  push rax
  pushf
  mov rax, _baseAddr
  add rax, [offset]
  cmp byte ptr [rax], 14
  jne originalcode
  mov r14d, [pJmp]
  popf
  pop rax
  mov [r13+rdx+000004FC],r14d
  jmp return

originalcode:
  popf
  pop rax
  movbe [r13+rdx+000004FC],r14d
  jmp return

moonjmp:
  jmp moonjmpmem
  nop 5

moonjmp2:
  jmp moonjmpmem
  nop 5

return:
]])

[DISABLE]
autoAssemble([[
moonjmp:
  db 45 0F 38 F1 B4 15 FC 04 00 00

moonjmp2:
  db 45 0F 38 F1 B4 15 FC 04 00 00
]])
