                      <ID>227797</ID>
                      <Description>"Faster"</Description>
                      <Options moHideChildren="1"/>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript Async="1">[ENABLE]
//aobscan(time,47 0F 38 F1 74 25 34 66 0F 11) // should be unique
//registersymbol(time)
{$lua}
timeAOB = 0x47, 0x0F, 0x38

if readBytes(getAddressSafe("time"),3,false) == timeAOB then
   timeScan = getAddressSafe("time")
else
   imeScan = AOBScan("47 0F 38 F1 74 25 34 66 0F 11")[0]
  registerSymbol("time", timeScan)
end
{$asm}

alloc(timemem,$100)
registersymbol(timemem)


define(pTime,timemem+75)
registersymbol(pTime)

define(counter,timemem+85)
registersymbol(counter)

define(old,timemem+95)
registersymbol(old)


label(originalcode)
label(return)

pTime:
  db #1
counter:
  db #0

timemem:
  pushf
  push eax
  push ebx
  movbe eax,[r13+r12+34]
  mov [old],eax
  mov eax,[pTime]
  mov ebx,r14d
  sub ebx,[old]
  mul ebx
  add eax,[old]
  mov r14d,eax
  jmp originalcode

originalcode:
  pop ebx
  pop eax
  popf
  movbe [r13+r12+34],r14d
  jmp return

time:
  jmp timemem
  nop 2
return:

[DISABLE]

time:
  db 47 0F 38 F1 74 25 34

unregistersymbol(old)
unregistersymbol(counter)
unregistersymbol(pTime)
unregistersymbol(timemem)
dealloc(timemem)
</AssemblerScript>
