                      <AssemblerScript Async="1">{$lua}
if syntaxcheck then return end
[ENABLE]

--aobscan(fastclimb,45 0F 38 F0 B4 05 90 73 00 00 66 41 0F 6E C6 F3 0F 5A C0 F2 0F 12 C0 BD 00 00 00 10 8B 5C 24 7C 41 0F B6 84 1D 23 30 00 00 66 0F 10 8C E4 E8 01 00 00 45 0F 38 F0 B4 2D 8C 72 00 00)
--alloc(newmem,$100,fastclimb)

climbAOB = {0x45, 0x0F, 0x38}
climbSpeed = (getAddressSafe("_baseaddr") + 0x1000728C)


if readBytes(getAddressSafe("fastclimb"),3,true) == climbAOB then
   climbScan = getAddressSafe("fastclimb")
else
  climbScan = AOBScan("45 0F 38 F0 B4 05 90 73 00 00 66 41 0F 6E C6 F3 0F 5A C0 F2 0F 12 C0 BD 00 00 00 10 8B 5C 24 7C 41 0F B6 84 1D 23 30 00 00 66 0F 10 8C E4 E8 01 00 00 45 0F 38 F0 B4 2D 8C 72 00 00")[0]
  climbScan = addOffset(climbScan, 32)
  registerSymbol("fastclimb", climbScan)
end

if climbSpeed and climbScan then
  climbBytes = readBytes(climbScan,10,true)
  writeBytes(climbScan, 0x41, 0xBE, 0x00, 0x00, 0xC0, 0x3F, 0x90, 0x90, 0x90, 0x90)
  writeBytes(climbSpeed, 0x41, 0x10, 0x00, 0x00)

end


[DISABLE]

writeBytes(climbScan, 0x45, 0x0F, 0x38, 0xF0, 0xB4, 0x2D, 0x8C, 0x72, 0x00, 0x00)
writeBytes(climbSpeed, 0x3F, 0xC0, 0x00, 0x00)


