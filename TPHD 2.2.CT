                        <CheatEntry>
                          <ID>533</ID>
                          <Description>"Spinner Mount Fix"</Description>
                          <VariableType>Auto Assembler Script</VariableType>
                          <AssemblerScript Async="1">{$lua}
if syntaxcheck then return end
[ENABLE]

--aobscan(spinfix,45 0F 38 F0 B4 05 1C 75 00 00 66 41 0F 6E C6 89) // should be unique
--registersymbol(spinfix)
if spinfixScan == nil then
spinfixScan = AOBScan("45 0F 38 F0 B4 05 1C 75 00 00 66 41 0F 6E C6 89 44 24 ?? B8 00")[0]
spinfixBytes = readBytes(spinfixScan, 16, false)
elseif readBytes(spinfixScan, 16, false) ~= spinfixBytes then
  spinfixScan = AOBScan("45 0F 38 F0 B4 05 1C 75 00 00 66 41 0F 6E C6 89 44 24 ?? B8 00")[1]
  spinfixBytes = readBytes(spinfixScan, 16, false)
end

registerSymbol("spinfix", spinfixScan)

autoAssemble([[
  alloc(spinfixmem,$100,spinfix)
  registersymbol(spinfixmem)

  label(return)

  spinfixmem:
    mov r14d,41D00000
    jmp return

  spinfix:
    jmp spinfixmem
    nop 5
  return:
  registersymbol(spinfixmem)
]])

[DISABLE]

autoAssemble([[
  spinfix:
    db 45 0F 38 F0 B4 05 1C 75 00 00

  unregistersymbol(spinfixmem)
  unregistersymbol(spinfix)
  dealloc(spinfixmem)
]])

unregisterSymbol(spinfix)

