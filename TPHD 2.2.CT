                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript Async="1">{$lua}
if syntaxcheck then return end
[ENABLE]

--aobscan(linkTakedmg,C6 25 FF 00 00 00 49 89 C6 66 41 C1 C6 08) // should be unique
--registersymbol(linkTakedmg)

takeDmgAOB = 0xC6, 0x25, 0xFF

if readBytes(getAddressSafe("linkTakedmg"),3,false) == takeDmgAOB then
  takeDmgScan = getAddressSafe("linkTakedmg")
else
  takeDmgScan = AOBScan("C6 25 FF 00 00 00 49 89 C6 66 41 C1 C6 08")[0]
  registerSymbol("linkTakedmg", takeDmgScan)
end

autoAssemble([[
label(return)
label(originalcode)

mult:
  db #1

healthBefore:
  db #0

takedmgmem:
  push rcx
  pushf
  mov cx,[r13+rdi+04]
  ror cx,08
  cmp cx,ax
  jl originalcode
  mov [healthBefore],cx
  sub ecx,eax
  mov eax,ecx
  mov cx,[mult]
  mul cl
  cmp eax,[healthBefore]
  jg negative
  sub [healthBefore],eax
  mov eax,[healthBefore]
  jmp originalcode

negative:
  mov eax, 0
  jmp originalcode

originalcode:
  pop rcx
  popf
  mov r14,rax
  rol r14w,08
  jmp return

linkTakedmg+06:
  jmp takedmgmem
  nop 3
return:
]])

[DISABLE]
autoAssemble([[
linkTakedmg+06:
  db 49 89 C6 66 41 C1 C6 08

]])


