[ENABLE]
coordsAOB = 0x45, 0x0F, 0x38

if readBytes(getAddressSafe("coords"),3,false) == coordsAOB then
   coordsScan = getAddressSafe("coords")
else
  coordsScan = AOBScan("45 0F 38 F0 B4 3D D8 04 00 00 66 41 0F 6E C6 89 BC ??")[0]
  registerSymbol("coords", coordsScan)
end
autoAssemble([[
  label(return)

  coordmem:
    pushf
    mov [_coordinates],r13
    add [_coordinates],rdi
    popf
    movbe r14d,[r13+rdi+000004D8]
    jmp return

  coords:
    jmp coordmem
    nop 5
  return:
]])

[DISABLE]
autoAssemble([[
  coords:
    db 45 0F 38 F0 B4 3D D8 04 00 00
]])


