clawExtend = list.getMemoryRecordByDescription("Clawshot Extend Speed")
clawReturn = list.getMemoryRecordByDescription("Clawshot Return Speed")
clawPull = list.getMemoryRecordByDescription("Clawshot Pull Speed")

clawRange.Value = 32000
clawExtend.Value = 500
clawReturn.Value = 500
clawPull.Value = 300

