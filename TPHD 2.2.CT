                  <Options moHideChildren="1"/>
                  <Color>0000FF</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript Async="1">[ENABLE]

aobscan(INJECT,83 C6 FF 0F BF F6 45) // should be unique
registersymbol(INJECT)
alloc(newmem,$250,INJECT)
registersymbol(newmem)
define(counter,newmem+225)
registersymbol(counter)
define(pTime,newmem+240)
registersymbol(pTime)

label(code)
label(originalcode)
label(return)

pTime:
  db 00

counter:
  db 00

newmem:
  cmp [pTime],00
  je originalcode
  push eax
  mov eax, [pTime]
  cmp [counter],al
  je code
  inc [counter]
  pop eax
  jmp return


originalcode:
  add esi,-01
  movsx esi,si
  jmp return

code:
  add esi,-01
  movsx esi,si
  mov [counter],00
  pop eax
  jmp return

INJECT:
  jmp newmem
  nop

return:
[DISABLE]

INJECT:
  db 83 C6 FF 0F BF F6

unregistersymbol(counter)
unregistersymbol(newmem)
unregistersymbol(INJECT)
dealloc(newmem)

