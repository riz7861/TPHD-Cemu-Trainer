                <CheatEntry>
                  <ID>607</ID>
                  <Description>"FlyCam (NOT WORKING)"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript Async="1">//-- Speed modifier for camera movement
globalalloc(speedModifier,8)
speedModifier:
  dd (float)7

{$lua}

[ENABLE]

function checkKeys()

  --Read and assign speed modifier value


  --Mouse Rotation in Radians
  --Use math.rad() to convert from degrees if game values aren't in radians
  --local pitch = math.rad(readFloat("[pCamStruct]+41C")) -- Vertical (Pitch)
  local pitch = readFloat("[_coordinates]+19C8C")
  local yaw = math.rad(readFloat("[_coordinates]+193B8")) -- Horizontal (Yaw)

  --Camera Coordinates
  local camx = readFloat("[_coordinates]+7C") -- Camera X
  local camy = readFloat("[_coordinates]+84") -- Camera Y
  local camz = readFloat("[_coordinates]+80") -- Camera Z

  --Sine and Cosine of Rotation Values
  local siny = math.sin(yaw) -- Sine of Horizontal (Yaw)
  local cosy = math.cos(yaw) -- Cosine of Horizontal (Yaw)
  local sinp = math.sin(pitch) -- Sine of Vertical (Pitch)
  local cosp = math.cos(pitch) -- Cosine of Vertical (Pitch)

  --Hotkey Setup
  --[[
        Button Mappings:

        W - Forward
        A - Left
        S - Backward
        D - Right
        T - Down
        U - Up
        V - Speed Up
        Alt - Slow Down

      --Key combinations for strafing are also defined
      --Keys are oriented to where mouse is pointing
  ]]

  --Forward
  if isKeyPressed(VK_W) then
    writeFloat("[_coordinates]+7C", camx + (cosy * speed))
    writeFloat("[_coordinates]+84", camy + (siny * speed))
    writeFloat("[_coordinates]+80", camz + (sinp * speed))
  end
  --Left
  if isKeyPressed(VK_A) then
    writeFloat("[_coordinates]+7C", camx + (math.cos(yaw - math.rad(90)) * speed))
    writeFloat("[_coordinates]+84", camy + (math.sin(yaw - math.rad(90)) * speed))
  end
  --Back
  if isKeyPressed(VK_S) then
    writeFloat("[_coordinates]+7C", camx - (cosy * speed))
    writeFloat("[_coordinates]+84", camy - (siny * speed))
    writeFloat("[_coordinates]+80", camz - (sinp * speed))
  end
  --Right
  if isKeyPressed(VK_D) then
    writeFloat("[_coordinates]+7C", camx - (math.cos(yaw - math.rad(90)) * speed))
    writeFloat("[_coordinates]+84", camy - (math.sin(yaw - math.rad(90)) * speed))
  end
  --Forward/Right
  if isKeyPressed(VK_W) and isKeyPressed(VK_D) then
    writeFloat("[_coordinates]+7C", camx + (math.cos(yaw + math.rad(45)) * speed))
    writeFloat("[_coordinates]+84", camy + (math.sin(yaw + math.rad(45)) * speed))
    writeFloat("[_coordinates]+80", camz + (sinp * speed))
  end
  --Forward/Left
  if isKeyPressed(VK_W) and isKeyPressed(VK_A) then
    writeFloat("[_coordinates]+7C", camx + (math.cos(yaw - math.rad(45)) * speed))
    writeFloat("[_coordinates]+84", camy + (math.sin(yaw - math.rad(45)) * speed))
    writeFloat("[_coordinates]+80", camz + (sinp * speed))
  end
  --Back/Left
  if isKeyPressed(VK_S) and isKeyPressed(VK_A) then
    writeFloat("[_coordinates]+7C", camx - (math.cos(yaw + math.rad(45)) * speed))
    writeFloat("[_coordinates]+84", camy - (math.sin(yaw + math.rad(45)) * speed))
    writeFloat("[_coordinates]+80", camz - (sinp * speed))
  end
  --Back/Right
  if isKeyPressed(VK_S) and isKeyPressed(VK_D) then
    writeFloat("[_coordinates]+7C", camx - (math.cos(yaw - math.rad(45)) * speed))
    writeFloat("[_coordinates]+84", camy - (math.sin(yaw - math.rad(45)) * speed))
    writeFloat("[_coordinates]+80", camz - (sinp * speed))
  end
end

t=createTimer(nil)
timer_setInterval(t, 10)
timer_onTimer(t, checkKeys())
timer_setEnabled(t, true)

[DISABLE]
timer_setEnabled(t, false)
